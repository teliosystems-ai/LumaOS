* text=auto

# Files executed or parsed by Linux must retain LF even in Windows checkouts.
*.sh text eol=lf
*.service text eol=lf
*.path text eol=lf
native/image/utc/chrony.conf text eol=lf
native/image/utc/*.asc text eol=lf
native/image/utc/*.c text eol=lf
native/image/utc/*.h text eol=lf
native/image/utc/*.json text eol=lf
native/image/utc/*.py text eol=lf
native/image/overlay/etc/apparmor.d/* text eol=lf
native/image/overlay/usr/bin/luma-admin-control text eol=lf
Makefile text eol=lf

# Native Windows launchers retain conventional Windows line endings.
*.ps1 text eol=crlf
