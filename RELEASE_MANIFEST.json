{
  "schema_version": 1,
  "project": "luma-os",
  "version": "0.1.0",
  "release_channel": "developer-mvp",
  "python": ">=3.11",
  "runtime_dependencies": [],
  "entry_points": {
    "module": "python -m luma_os.cli",
    "console_script": "luma-os",
    "posix_source_runner": "scripts/run.sh",
    "windows_source_runner": "scripts/run.ps1"
  },
  "supported_environments": [
    {
      "platform": "Ubuntu",
      "version": "24.04 LTS",
      "level": "primary-developer"
    },
    {
      "platform": "Windows",
      "version": "11 with WSL2 and Ubuntu 24.04",
      "level": "supported-developer"
    }
  ],
  "release_inputs": [
    "src",
    "tests",
    "web",
    "schemas",
    "examples",
    "docs",
    "scripts",
    "packaging",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "Makefile",
    "pyproject.toml",
    ".gitignore",
    ".editorconfig",
    "RELEASE_MANIFEST.json"
  ],
  "release_files": [
    ".editorconfig",
    ".gitignore",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "Makefile",
    "README.md",
    "RELEASE_MANIFEST.json",
    "SECURITY.md",
    "docs/ARCHITECTURE.md",
    "docs/DEVELOPMENT_PLAN.md",
    "docs/GOVERNING_REQUIREMENTS_SOURCES.md",
    "docs/OPERATIONS.md",
    "docs/RELEASE.md",
    "docs/REQUIREMENTS_COVERAGE.md",
    "docs/ROADMAP.md",
    "docs/SUPPORT_MATRIX.md",
    "docs/THREAT_MODEL.md",
    "docs/governing_sources.json",
    "examples/README.md",
    "examples/invoices.csv",
    "packaging/systemd/README.md",
    "packaging/systemd/install-user-service.sh",
    "packaging/systemd/luma-os.service",
    "packaging/wsl/README.md",
    "packaging/wsl/install.ps1",
    "packaging/wsl/launch.ps1",
    "pyproject.toml",
    "schemas/artifact.schema.json",
    "schemas/grant.schema.json",
    "schemas/openapi.yaml",
    "schemas/receipt.schema.json",
    "schemas/workflow.schema.json",
    "scripts/build_release.py",
    "scripts/check.py",
    "scripts/install-user.sh",
    "scripts/run.ps1",
    "scripts/run.sh",
    "scripts/uninstall-user.sh",
    "src/luma_os/__init__.py",
    "src/luma_os/artifacts.py",
    "src/luma_os/cli.py",
    "src/luma_os/config.py",
    "src/luma_os/db.py",
    "src/luma_os/errors.py",
    "src/luma_os/grants.py",
    "src/luma_os/models.py",
    "src/luma_os/server.py",
    "src/luma_os/service.py",
    "src/luma_os/workflows.py",
    "tests/browser_test.cjs",
    "tests/test_contract_files.py",
    "tests/test_core.py",
    "web/app.js",
    "web/index.html",
    "web/styles.css"
  ],
  "required_release_files": [
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "docs/ARCHITECTURE.md",
    "docs/THREAT_MODEL.md",
    "docs/REQUIREMENTS_COVERAGE.md",
    "docs/ROADMAP.md",
    "docs/SUPPORT_MATRIX.md",
    "docs/OPERATIONS.md",
    "docs/RELEASE.md",
    "docs/DEVELOPMENT_PLAN.md",
    "docs/GOVERNING_REQUIREMENTS_SOURCES.md",
    "docs/governing_sources.json"
  ],
  "excluded_from_release": [
    ".git",
    ".github",
    ".venv",
    "build",
    "dist",
    "models",
    "weights",
    "data",
    "var",
    "__pycache__"
  ],
  "external_assets": {
    "model_weights_included": false,
    "datasets_included": false,
    "operator_responsibility": "Obtain and license all models, weights, datasets, and remote services separately."
  },
  "unsupported": [
    "production deployment",
    "bootable ISO",
    "dual-boot installation",
    "virtual-machine lifecycle automation",
    "400B model certification",
    "cluster certification",
    "simulator-as-acceptance-test"
  ]
}
