[Unit]
Description=Luma isolated D-backed containerd
Requires=luma-build-store.service
After=luma-build-store.service
Before=luma-build-docker.service

[Service]
Type=notify
Slice=luma-build.slice
MemorySwapMax=0
Environment=TMPDIR=/mnt/luma-build/tmp/containerd
ExecStartPre=/usr/bin/python3 /usr/local/libexec/luma-build-storage.py verify
ExecStart=/usr/bin/containerd --config /etc/luma-build/containerd.toml
TimeoutStartSec=90
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=0
TasksMax=infinity
Delegate=yes
KillMode=process
