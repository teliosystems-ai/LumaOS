ARG UBUNTU_BASE=ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
FROM ${UBUNTU_BASE}
ARG SNAPSHOT=20260927T000000Z
ARG EDITION=headless
ENV DEBIAN_FRONTEND=noninteractive
# Bootstrap TLS from exact signed noble-release packages, never moving updates.
# The base has the archive keyring but no CA bundle. Snapshot HTTP redirects to
# HTTPS; retain TLS verification and use the release-only archive for this step.
RUN printf '%s\n' 'deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] http://archive.ubuntu.com/ubuntu noble main' > /tmp/luma-bootstrap.list && \
    apt-get update -o Dir::Etc::sourcelist=/tmp/luma-bootstrap.list -o Dir::Etc::sourceparts=- -o APT::Update::Error-Mode=any && \
    apt-get install -y --no-install-recommends -o Dir::Etc::sourcelist=/tmp/luma-bootstrap.list -o Dir::Etc::sourceparts=- \
      ca-certificates=20240203 ubuntu-keyring=2023.11.28.1 openssl=3.0.13-0ubuntu3 && \
    rm /tmp/luma-bootstrap.list
RUN apt-get update --snapshot=${SNAPSHOT} -o APT::Update::Error-Mode=any && \
    apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
      systemd systemd-sysv systemd-resolved systemd-timesyncd systemd-boot-efi \
      systemd-ukify libpam-systemd libcrypt1 dbus sudo bash coreutils util-linux \
      linux-image-generic linux-firmware \
      dracut-core cryptsetup-bin dmsetup e2fsprogs dosfstools gdisk \
      apparmor apparmor-utils openssl sbsigntool python3 libsqlite3-0 iproute2 \
      network-manager rsync zstd less nano kmod pciutils usbutils && \
    if [ "$EDITION" = desktop ]; then \
      apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
        gdm3 gnome-session gnome-shell gnome-console nautilus gnome-text-editor \
        gnome-control-center network-manager-gnome epiphany-browser \
        xdg-desktop-portal-gnome fonts-dejavu-core \
        python3-gi gir1.2-gtk-3.0 gir1.2-webkit2-4.1 \
        gir1.2-gstreamer-1.0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        gstreamer1.0-pipewire xdg-desktop-portal pipewire-pulse; \
    elif [ "$EDITION" != headless ]; then exit 2; fi
# Image assembly records the exact installed tuple and strips builder/container state.
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} systemd-boot
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} curl libgomp1
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
    libgnutls30t64 libnettle8t64 libhogweed6t64 libcap2 libseccomp2
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
    libtss2-esys-3.0.2-0t64 libtss2-tctildr0t64 libtss2-tcti-device0t64 tpm2-tools
COPY llama-runtime.tar.gz /tmp/luma-llama-runtime.tar.gz
RUN \
    echo 'a836c913236ab4533ef9aaf49f0e1ad2955c8159869d7eec1a9072a92e13d61b  /tmp/luma-llama-runtime.tar.gz' | sha256sum -c - && \
    mkdir -p /usr/libexec/luma-os/llama && \
    tar -xzf /tmp/luma-llama-runtime.tar.gz --strip-components=1 -C /usr/libexec/luma-os/llama && \
    rm /tmp/luma-llama-runtime.tar.gz /usr/libexec/luma-os/llama/libggml-rpc.so /usr/libexec/luma-os/llama/ggml-rpc-server && \
    LD_LIBRARY_PATH=/usr/libexec/luma-os/llama /usr/libexec/luma-os/llama/llama-server --version
# Keep the fixed KVM dependency separate so adding it does not invalidate the
# large, already pinned firmware and desktop package layers.
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} qemu-system-x86
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
    tcc=0.9.27+git20200814.62c30a4a-1 libtcc-dev=0.9.27+git20200814.62c30a4a-1
RUN mkdir -p /usr/src/luma-tcc && cd /usr/src/luma-tcc && \
    curl --fail --location --silent --show-error --max-time 120 \
      https://snapshot.ubuntu.com/ubuntu/20260927T000000Z/pool/universe/t/tcc/tcc_0.9.27+git20200814.62c30a4a-1.dsc \
      -o tcc_0.9.27+git20200814.62c30a4a-1.dsc && \
    curl --fail --location --silent --show-error --max-time 120 \
      https://snapshot.ubuntu.com/ubuntu/20260927T000000Z/pool/universe/t/tcc/tcc_0.9.27+git20200814.62c30a4a.orig.tar.bz2 \
      -o tcc_0.9.27+git20200814.62c30a4a.orig.tar.bz2 && \
    curl --fail --location --silent --show-error --max-time 120 \
      https://snapshot.ubuntu.com/ubuntu/20260927T000000Z/pool/universe/t/tcc/tcc_0.9.27+git20200814.62c30a4a-1.debian.tar.xz \
      -o tcc_0.9.27+git20200814.62c30a4a-1.debian.tar.xz && \
    printf '%s\n' \
      '3d211ea8e260e6b846c9a085ea43229c48b20871be7a7ad8f520b2d345587cfd  tcc_0.9.27+git20200814.62c30a4a-1.dsc' \
      'd63c113bcdd657f51c8ee197a0b0a24203603313e19a52b5f678d40ab7f5df35  tcc_0.9.27+git20200814.62c30a4a.orig.tar.bz2' \
      '27036dd5f67b6ce3b8212080d1d6e55b1f7b2e54a23d0f2a4af38090a8d75716  tcc_0.9.27+git20200814.62c30a4a-1.debian.tar.xz' | sha256sum -c -
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} libreoffice-writer bubblewrap
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} power-profiles-daemon=0.21-1ubuntu3
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} g++ cmake \
    libespeak-ng1=1.51+dfsg-12build1 espeak-ng-data=1.51+dfsg-12build1 libespeak-ng-dev=1.51+dfsg-12build1
COPY speech/inputs/ /usr/src/luma-speech/inputs/
COPY speech/ggml-tiny.bin /usr/share/luma-os/speech/ggml-tiny.bin
RUN printf '%s\n' \
    '645445da884df6dbd52b30f82d7be7c01d1767c938714e477e786b88d529e9f4  /usr/src/luma-speech/inputs/whisper-source.tar.gz' \
    'b5d65a59060e68c4ff940e1eddfa6f94b2d68fdf58ed7f4dd57721c997e35e9d  /usr/src/luma-speech/inputs/model-LICENSE' \
    '7d7e4f7606f1ddf3eb497a4848649eb72fc0acf70caccd9a61987f4d4444d688  /usr/src/luma-speech/inputs/espeak-ng_1.51+dfsg-12build1.dsc' \
    '72242d7c06a4d80f5056335977c5be1ff79ff27bb502d4d054be1803ff787fa9  /usr/src/luma-speech/inputs/espeak-ng_1.51+dfsg.orig.tar.gz' \
    'ccd4411d9efe0604030c604bd7369ec19598bc4d2b6435a0782398e174c0ee54  /usr/src/luma-speech/inputs/espeak-ng_1.51+dfsg-12build1.debian.tar.xz' \
    'be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21  /usr/share/luma-os/speech/ggml-tiny.bin' | sha256sum -c -
CMD ["/sbin/init"]
