ARG UBUNTU_BASE=ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
FROM ${UBUNTU_BASE}
ARG SNAPSHOT=20260927T000000Z
ARG EDITION=headless
ENV DEBIAN_FRONTEND=noninteractive
# Bootstrap TLS from exact signed noble-release packages, never moving updates.
# The base has the archive keyring but no CA bundle. Snapshot HTTP redirects to
# HTTPS; retain TLS verification and use the release-only archive for this step.
RUN printf '%s\n' 'deb [signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] http://archive.ubuntu.com/ubuntu noble main' > /tmp/luma-bootstrap.list && \
    apt-get update -o Dir::Etc::sourcelist=/tmp/luma-bootstrap.list -o Dir::Etc::sourceparts=- -o APT::Update::Error-Mode=any && \
    apt-get install -y --no-install-recommends -o Dir::Etc::sourcelist=/tmp/luma-bootstrap.list -o Dir::Etc::sourceparts=- \
      ca-certificates=20240203 ubuntu-keyring=2023.11.28.1 openssl=3.0.13-0ubuntu3 && \
    rm /tmp/luma-bootstrap.list
RUN apt-get update --snapshot=${SNAPSHOT} -o APT::Update::Error-Mode=any && \
    apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
      systemd systemd-sysv systemd-resolved systemd-timesyncd systemd-boot-efi \
      systemd-ukify libpam-systemd libcrypt1 dbus sudo bash coreutils util-linux \
      linux-image-generic linux-firmware \
      dracut-core cryptsetup-bin dmsetup e2fsprogs dosfstools gdisk \
      apparmor apparmor-utils openssl sbsigntool python3 libsqlite3-0 iproute2 \
      network-manager rsync zstd less nano kmod pciutils usbutils && \
    if [ "$EDITION" = desktop ]; then \
      apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
        gdm3 gnome-session gnome-shell gnome-console nautilus gnome-text-editor \
        gnome-control-center network-manager-gnome epiphany-browser \
        xdg-desktop-portal-gnome fonts-dejavu-core; \
    elif [ "$EDITION" != headless ]; then exit 2; fi
# Image assembly records the exact installed tuple and strips builder/container state.
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} systemd-boot
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} curl libgomp1
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
    libgnutls30t64 libnettle8t64 libhogweed6t64 libcap2 libseccomp2
RUN apt-get install -y --no-install-recommends --snapshot=${SNAPSHOT} \
    libtss2-esys-3.0.2-0t64 libtss2-tctildr0t64 libtss2-tcti-device0t64 tpm2-tools
COPY llama-runtime.tar.gz /tmp/luma-llama-runtime.tar.gz
RUN \
    echo 'a836c913236ab4533ef9aaf49f0e1ad2955c8159869d7eec1a9072a92e13d61b  /tmp/luma-llama-runtime.tar.gz' | sha256sum -c - && \
    mkdir -p /usr/libexec/luma-os/llama && \
    tar -xzf /tmp/luma-llama-runtime.tar.gz --strip-components=1 -C /usr/libexec/luma-os/llama && \
    rm /tmp/luma-llama-runtime.tar.gz /usr/libexec/luma-os/llama/libggml-rpc.so /usr/libexec/luma-os/llama/ggml-rpc-server && \
    LD_LIBRARY_PATH=/usr/libexec/luma-os/llama /usr/libexec/luma-os/llama/llama-server --version
CMD ["/sbin/init"]
