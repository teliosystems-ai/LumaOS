#include <tunables/global>

profile luma-acquisition flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  capability setuid,
  capability setgid,
  capability kill,
  # Available only in the generated action's systemd capability ceiling;
  # the fixed runner uses it to irreversibly drop its child's bounding set.
  capability setpcap,
  ptrace (readby) peer=luma-broker,
  signal (receive) peer=luma-broker,
  network inet stream,
  network inet6 stream,
  network unix stream,
  signal (send, receive) set=(kill) peer=luma-acquisition,
  signal (send) set=(kill) peer=luma-generated-qemu,
  signal (receive) peer=unconfined,

  /usr/libexec/luma-os/luma-platform mrix,
  /usr/bin/curl mrix,
  /usr/bin/python3{,.12} mrix,
  /usr/libexec/luma-os/generated_runtime.py r,
  /usr/libexec/luma-os/generated_build.py r,
  /usr/bin/qemu-system-x86_64 mrpx -> &luma-generated-qemu,
  /usr/share/qemu/** r,
  /usr/share/seabios/** r,
  /dev/kvm rw,
  /usr/share/luma-os/generated/** r,
  /usr/share/luma-os/ r,
  /usr/share/luma-os/release-identity.json r,
  /usr/share/luma-os/content-custody-policy.json r,
  /usr/share/luma-os/adapters/ r,
  /usr/share/luma-os/adapters/office-pdf-v1.json r,
  /usr/bin/bwrap r,
  /usr/share/luma-os/models/ r,
  /usr/share/luma-os/models/** r,
  /usr/share/luma-os/model-packs/ r,
  /usr/share/luma-os/model-packs/** r,
  /usr/lib/** mr,
  /lib/** mr,
  /etc/ssl/** r,
  /usr/share/ca-certificates/** r,
  /etc/passwd r,
  /etc/group r,
  /etc/shadow r,
  /etc/gshadow r,
  /proc/cmdline r,
  /proc/meminfo r,
  /proc/sys/kernel/random/boot_id r,
  /proc/[0-9]*/{stat,status,cgroup,cmdline,limits} r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  /proc/[0-9]*/attr/current r,
  /sys/fs/cgroup/** r,
  /sys/devices/** r,
  /sys/dev/block/** r,
  /run/luma-broker/control.sock rw,
  /run/luma-content-custody/control.sock rw,
  /memfd:luma-workflow-input r,
  /memfd:luma-workflow-output rw,
  /memfd:luma-generated-{request,executable,input} r,
  /memfd:luma-generated-output rw,
  /memfd:luma-content-request r,
  /memfd:luma-content-output rw,
  /memfd:luma-generated-{kernel,initrd} rw,

  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ rw,
  /var/lib/luma-os/content-store/ rw,
  /var/lib/luma-os/content-store/** rwk,
  deny /var/lib/luma-os/content-checkpoint/** rwklmx,
  deny /run/luma-content-checkpoint/** rwklmx,
  /var/lib/luma-os/principals/ r,
  /var/lib/luma-os/principals/registry.json r,
  /var/lib/luma-os/models/ rw,
  /var/lib/luma-os/models/* rwk,
  /var/lib/luma-os/model-packs/ rw,
  /var/lib/luma-os/model-packs/** rwk,
  /var/lib/luma-os/model-activation.pending r,
  /var/lib/luma-os/identity/ rw,
  /var/lib/luma-os/identity/{passwd,group,shadow,gshadow,migration.lock} rwk,
  /var/lib/luma-os/identity/*.{new,tmp}-* rwk,
  /var/lib/luma-os/staging/ r,
  /var/lib/luma-os/staging/install-*/ r,
  /var/lib/luma-os/staging/install-*/data/ r,
  /var/lib/luma-os/staging/install-*/data/lib/ r,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/ rw,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/models/ rw,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/models/* rwk,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/model-activation.pending r,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/identity/ rw,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/identity/{passwd,group,shadow,gshadow,migration.lock} rwk,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/identity/*.{new,tmp}-* rwk,
}
