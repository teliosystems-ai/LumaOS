#include <tunables/global>
profile luma-admin flags=(attach_disconnected) {
  #include <abstractions/base>
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/luma-auth-helper mrix,
  /usr/sbin/unix_chkpwd mrix,
  /usr/bin/systemd-creds mrix,
  /usr/libexec/luma-os/luma-utc-restart Px -> luma-utc-restart,
  /usr/libexec/luma-os/luma-utc-restart r,
  /etc/apparmor.d/luma-utc-restart r,
  /etc/apparmor.d/luma-granted-client r,
  / r,
  /usr/ r,
  /usr/{lib,libexec,share}/ r,
  /usr/libexec/luma-os/ r,
  /usr/lib/systemd/ r,
  /usr/lib/systemd/system/ r,
  /usr/share/luma-os/ r,
  /etc/ r,
  /etc/apparmor.d/ r,
  /run/ r,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/pam.d/** r,
  /etc/{passwd,shadow,group,gshadow,nsswitch.conf,login.defs} r,
  /etc/security/** r,
  /proc/cmdline r,
  /proc/sys/kernel/random/boot_id r,
  owner /proc/@{pid}/** r,
  /sys/fs/cgroup/system.slice/luma-admin.service/{memory.max,memory.swap.max,pids.max} r,
  /sys/fs/cgroup/system.slice/luma-peer-observer.service/{memory.max,memory.swap.max,pids.max} r,
  /usr/share/luma-os/admin-pcr-public.pem r,
  /usr/share/luma-os/utc/** r,
  /usr/lib/systemd/system/luma-utc-*.service r,
  /etc/apparmor.d/luma-utc-{keeper,producer} r,
  /run/luma-utc-control/ r,
  /run/luma-utc-control/{query,control}.sock rw,
  /run/systemd/tpm2-pcr-signature.json r,
  /var/lib/luma-os/principals/ rw,
  /var/lib/luma-os/principals/registry.json rw,
  # The socket service's read-only identity mount and request parser prohibit
  # these mutations. Reviewed local account maintenance uses fixed paths only.
  /var/lib/luma-os/identity/ rw,
  /var/lib/luma-os/identity/{passwd,shadow,group,gshadow} rw,
  /var/lib/luma-os/identity/migration.lock rwk,
  /var/lib/luma-os/identity/account-transition-*/ rw,
  /var/lib/luma-os/identity/account-transition-*/{intent.json,shadow.new,recovery.json} rw,
  /var/lib/luma-os/identity/.password-proposal-*/ rw,
  /var/lib/luma-os/identity/.password-proposal-*/{intent.json,shadow.new} rw,
  /var/lib/luma-os/identity/account-deletion-*/ rw,
  /var/lib/luma-os/identity/account-deletion-*/intent.json rw,
  /var/lib/luma-os/identity/account-deletion-*/{passwd,shadow,group,gshadow}.{before,after,next} rw,
  /var/lib/luma-os/identity/.deletion-proposal-*/ rw,
  /var/lib/luma-os/identity/.deletion-proposal-*/intent.json rw,
  /var/lib/luma-os/identity/.deletion-proposal-*/{passwd,shadow,group,gshadow}.{before,after} rw,
  /var/lib/luma-os/identity/account-creation-*/ rw,
  /var/lib/luma-os/identity/account-creation-*/intent.json rw,
  /var/lib/luma-os/identity/account-creation-*/{passwd,shadow,group,gshadow,registry}.{before,after,next} rw,
  /var/lib/luma-os/identity/account-creation-*/home/ rw,
  /var/lib/luma-os/identity/account-creation-*/home/.luma-creation.json rw,
  /var/lib/luma-os/identity/.creation-proposal-*/ rw,
  /var/lib/luma-os/identity/.creation-proposal-*/intent.json rw,
  /var/lib/luma-os/identity/.creation-proposal-*/{passwd,shadow,group,gshadow,registry}.{before,after} rw,
  /var/lib/luma-os/identity/.creation-proposal-*/home/ rw,
  /var/lib/luma-os/identity/.creation-proposal-*/home/.luma-creation.json rw,
  /var/home/ rw,
  /var/home/*/ rw,
  /var/home/*/.luma-creation.json r,
  /var/lib/luma-os/admin/ rw,
  /var/lib/luma-os/admin/{anchor.json,nv-auth.cred,parent.name,enrollment.json,bootstrap.json} r,
  /var/lib/luma-os/admin/{journal.json,journal.pending.json,journal.pending.new-*} rwk,
  /var/lib/luma-os/admin/journal.lock rwk,
  /var/lib/luma-os/admin/event-*.json rwk,
  /run/luma-admin/ rw,
  /run/luma-admin/** rwk,
  /run/luma-governance/ rw,
  /run/luma-governance/** rw,
  /run/luma-peer-observer/ r,
  /run/luma-peer-observer/credentials.sock rw,
  /dev/tpmrm0 rw,
  /dev/{urandom,random} r,
  /dev/null rw,
  /dev/tty rw,
  /memfd:luma-private-credential rwkm,
  capability chown,
  # Local creation must inspect its new user-owned mode-0700 home. The socket
  # service keeps CAP_CHOWN as its sole capability and cannot acquire this one.
  capability dac_override,
  network unix stream,
  network unix seqpacket,
  signal (send,receive) peer=luma-admin,
  signal (send,receive) peer=luma-utc-restart,
  signal (receive) peer=unconfined,
  deny /dev/{mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
  deny /var/lib/luma-os/models/** rwklx,
  deny /var/lib/luma-os/reference/** rwklx,
  deny /var/lib/luma-os/artifacts/** rwklx,
}
