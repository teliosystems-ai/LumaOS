#include <tunables/global>

profile luma-broker flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  capability sys_ptrace,
  ptrace (read) peer=luma-acquisition,
  ptrace (read) peer=luma-editor,
  ptrace (read) peer=luma-office-export,
  ptrace (read) peer=luma-content-backup,
  ptrace (read) peer=luma-content-restore,
  ptrace (read) peer=luma-content-custody,
  ptrace (read) peer=luma-utc-windows,
  ptrace (read) peer=luma-qa-supervisor,
  ptrace (read) peer=luma-model,
  ptrace (read) peer=luma-reference,
  ptrace (read) peer=luma-granted-client,
  ptrace (read) peer=luma-hardware,
  ptrace (read) peer=unconfined,
  deny ptrace (trace, tracedby),
  signal (receive) peer=unconfined,
  signal (send) set=(kill) peer=luma-acquisition,
  signal (send) set=(kill) peer=luma-editor,
  signal (send) set=(kill) peer=luma-office-export,
  signal (send) set=(kill) peer=luma-office-convert,
  signal (send) set=(kill) peer=luma-content-backup,
  signal (send) set=(kill) peer=luma-content-restore,
  signal (send) set=(kill) peer=luma-qa-supervisor,
  signal (send) set=(kill) peer=luma-model-qa,
  signal (send) set=(kill) peer=luma-model,
  signal (send) set=(kill) peer=luma-generated-qemu,
  network unix stream,
  network unix dgram,
  network unix seqpacket,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/bin/{openssl,systemctl,lsblk,blkid} mrix,
  /usr/bin/systemd-creds mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/luma-os/** r,
  /usr/src/ r,
  /usr/src/luma-speech/ r,
  /usr/src/luma-speech/controller/ r,
  /usr/src/luma-speech/controller/{asr_engine.cpp,asr_worker.cpp} r,
  /etc/os-release r,
  /etc/apparmor.d/luma-* r,
  /etc/systemd/system/** r,
  /etc/ssl/** r,
  /etc/pam.d/** r,
  /etc/security/** r,
  /etc/{passwd,group,shadow,gshadow} r,
  /proc/cmdline r,
  /proc/{meminfo,cpuinfo,uptime,partitions,mounts} r,
  /proc/sys/kernel/random/boot_id r,
  /proc/@{pid}/{stat,status,cgroup,cmdline,limits,mountinfo,exe} r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/fd/ r,
  /proc/@{pid}/fd/[0-9]* r,
  /proc/@{pid}/fdinfo/[0-9]* r,
  /proc/@{pid}/task/ r,
  /proc/@{pid}/task/@{pid}/ r,
  /proc/@{pid}/task/@{pid}/{stat,status,cgroup,cmdline} r,
  deny /proc/@{pid}/{mem,environ} rw,
  deny /proc/@{pid}/task/@{pid}/{mem,environ} rw,
  deny /proc/{kcore,sysrq-trigger} rw,
  /sys/** r,
  /sys/fs/cgroup/lumamodel.slice/** rw,
  /sys/fs/cgroup/lumaacquisition.slice/** rw,
  # Only the closed 128/256 MiB C parent memory.max transition is writable.
  # No service-child, cgroup.kill, arbitrary system slice or new quota access.
  /sys/fs/cgroup/system.slice/system-lumacustody.slice/memory.max rw,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/system.slice/ r,
  /sys/fs/cgroup/system.slice/luma-utc-windows.service/ r,
  /sys/fs/cgroup/system.slice/luma-utc-windows.service/{memory.max,memory.swap.max,pids.max,cpu.max} r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/** r,
  /var/lib/luma-os/resource-checkpoint/paired/** rwk,
  /var/lib/luma-broker/ rw,
  /var/lib/luma-broker/** rwk,
  /run/luma-broker/ rw,
  /run/luma-broker/** rwk,
  /run/luma-admin/ rw,
  /run/luma-admin/** rwk,
  /run/luma-hardware/ rw,
  /run/luma-hardware/worker-{model,acquisition}.lock rwk,
  /run/luma-granted-client/ r,
  /run/luma-granted-client/requests/ r,
  /run/luma-granted-client/requests/*/ r,
  /run/luma-granted-client/requests/*/content.json r,
  /run/luma-granted-client/requests/*/index.json r,
  /run/luma-granted-client/requests/*/content-backup.json r,
  /run/luma-granted-client/requests/*/content-backup-recipients.json r,
  /run/luma-granted-client/requests/*/content-restore.json r,
  /run/luma-granted-client/requests/*/content-restore-retire.json r,
  /run/luma-model-qa/** r,
  /run/luma-resource-checkpoint/authority.lock rwk,
  /run/luma-utc/** r,
  /run/luma-utc-control/ r,
  /run/luma-utc-control/query.sock rw,
  /run/systemd/** r,
  /run/systemd/private rw,
  /run/dbus/system_bus_socket rw,
  /run/udev/data/** r,
  /tmp/** rwk,
  /dev/tpmrm0 rw,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  /memfd:luma-{release,model}-{root,key,message,signature} rwk,
  /memfd:luma-credential-* rwk,
  /memfd:luma-private-credential rwkm,
  /memfd:luma-workflow-{input,output} r,
  /memfd:luma-content-backup-{request,output} r,
  /memfd:luma-content-restore-output r,
  /efi/** r,
  /boot/** r,
  deny /dev/{mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /efi/** wklmx,
  deny /boot/** wklmx,
  deny /var/lib/luma-os/identity/** wklmx,
  deny /var/lib/luma-os/models/** wklmx,
  deny /var/lib/luma-os/model-packs/** wklmx,
  deny /var/lib/luma-os/model-qa/** wklmx,
  deny /var/lib/luma-os/content-checkpoint/** rwklmx,
  deny /var/lib/luma-os/utc-windows/** rwklmx,
  deny /var/lib/luma-os/utc-windows-checkpoint/** rwklmx,
  deny /run/luma-utc-windows-checkpoint/** rwklmx,
  deny /run/luma-content-checkpoint/** rwklmx,
}
