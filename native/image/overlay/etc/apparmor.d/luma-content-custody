#include <tunables/global>

profile luma-content-custody flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  deny ptrace (trace, tracedby),
  deny ptrace (readby) peer=luma-content-custody,
  deny ptrace (readby) peer=unconfined,
  /usr/libexec/luma-os/luma-platform mrix,
  # Stack instead of replacing C: NNP only permits a label subset transition.
  /usr/libexec/luma-os/luma-receipt-signer rpx -> &luma-receipt-signer,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  / r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/content-checkpoint/ r,
  /var/lib/luma-os/content-checkpoint/genesis.json r,
  /var/lib/luma-os/content-checkpoint/{history.json,history.prepared.json,history.publish.json} rw,
  # Closed paged C data classes. The native parser additionally enforces exact
  # canonical hash/job/slot names, held inode identities and selected NV; these
  # rules do not grant C any direct owner-content or external path access.
  /var/lib/luma-os/content-checkpoint/paged-v3/ rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/identity.json rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/{selected.json,pending.json} rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/{pages,records,attempts,tails,controls}/ rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/{pages,records}/[0-9a-f][0-9a-f]/ rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/{pages,records}/[0-9a-f][0-9a-f]/[0-9a-f][0-9a-f]/ rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/{pages,records}/[0-9a-f][0-9a-f]/[0-9a-f][0-9a-f]/[0-9a-f]* rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/attempts/[0-9a-f]*/ rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/attempts/[0-9a-f]*/{base.json,next.json,prepared.json,selector.json,dispatch.json,completed.json,retired.json} rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/tails/[0-9a-f]*/ rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/tails/[0-9a-f]*/identity.json rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/tails/[0-9a-f]*/[0-9a-f]* rw,
  /var/lib/luma-os/content-checkpoint/paged-v3/controls/{selector-0,selector-1,pending} rw,
  /var/lib/luma-os/content-checkpoint/sealed/ r,
  /var/lib/luma-os/content-checkpoint/sealed/{anchor.json,nv-auth.cred} r,
  /var/lib/luma-os/content-checkpoint/sealed/receipt-signer.json rw,
  /run/ r,
  /run/luma-content-checkpoint/ r,
  /run/luma-content-checkpoint/authority.lock rwk,
  /run/luma-content-custody/ rw,
  /run/luma-content-custody/control.sock rw,
  /run/luma-content-data-observer/ r,
  /run/luma-content-data-observer/read.sock rw,
  /run/luma-broker/control.sock rw,
  /run/systemd/ r,
  /run/systemd/tpm2-pcr-signature.json r,
  /usr/ r,
  /usr/share/ r,
  /usr/share/luma-os/ r,
  /usr/share/luma-os/{release-identity.json,admin-pcr-public.pem} r,
  /usr/share/luma-os/source-lock.json r,
  /usr/share/luma-os/content-index-policy.json r,
  /proc/cmdline r,
  /proc/@{pid}/{stat,cgroup,mountinfo} r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/fdinfo/[0-9]* r,
  /sys/ r,
  /sys/kernel/ r,
  /sys/kernel/security/ r,
  /sys/kernel/security/apparmor/ r,
  /sys/kernel/security/apparmor/features/ r,
  /sys/kernel/security/apparmor/features/network/ r,
  /sys/kernel/security/apparmor/features/network/af_unix r,
  # Read-only kernel identity for the exact LUKS2 /var and verity-root tuple.
  # No raw block-device access, mutable sysfs attribute or private product data.
  /sys/dev/ r,
  /sys/dev/block/ r,
  /sys/dev/block/[0-9]*:[0-9]* r,
  /sys/devices/ r,
  /sys/devices/**/ r,
  /sys/devices/virtual/block/dm-[0-9]*/dm/{name,uuid} r,
  /sys/devices/virtual/block/dm-[0-9]*/slaves/* r,
  /sys/devices/**/partition r,
  /dev/tpmrm0 rw,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  /memfd:luma-private-credential rwkm,
  unix (create) type=stream,
  unix (bind,listen,accept) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream addr=none,
  unix (send,receive) type=stream addr=none peer=(addr=none,label=luma-content-custody),
  unix (send,receive) type=stream addr=none peer=(addr=none,label="luma-content-custody//&luma-receipt-signer"),
  unix (connect,send,receive) type=stream peer=(label=luma-broker),
  unix (connect,send,receive) type=stream peer=(label=luma-content-data-observer),
  unix (send,receive) type=stream peer=(label=luma-acquisition),
  unix (send,receive) type=stream peer=(label=luma-office-export),
  unix (send,receive) type=stream peer=(label=luma-content-backup),
  unix (send,receive) type=stream peer=(label=luma-content-restore),
  unix (send,receive) type=stream peer=(label=luma-granted-client),
  deny unix (bind,listen,accept) addr=@**,
  deny unix (connect,send,receive) peer=(addr=@**),
  deny network inet,
  deny network inet6,
  ptrace (readby) peer=luma-broker,
  signal (receive) peer=unconfined,
  signal (send,receive) set=(kill) peer=luma-content-custody,
  signal (send) set=(kill) peer="luma-content-custody//&luma-receipt-signer",
  deny /var/lib/luma-os/{admin,identity,principals,models,model-packs,resource-checkpoint}/** rwklmx,
  deny /var/lib/luma-os/content-store/** rwklmx,
  deny /var/lib/luma-os/{utc-windows,utc-windows-checkpoint}/** rwklmx,
  deny /run/luma-admin/** rwklmx,
  deny /run/luma-resource-checkpoint/** rwklmx,
  deny /dev/{tpm0,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /dev/log rw,
  deny /{,var/}run/uuidd/request rw,
  deny /{,var/}run/systemd/journal/{dev-log,socket,stdout} rw,
}
