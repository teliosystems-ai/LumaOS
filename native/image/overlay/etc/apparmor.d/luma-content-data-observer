#include <tunables/global>

# Query-only byte/metadata membrane. This profile has no TPM, C checkpoint,
# broker, signing, mutation, account, model, plaintext export or repair access.
profile luma-content-data-observer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  / r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/content-store/ r,
  /var/lib/luma-os/content-store/v2-[0-9a-f]*/ r,
  /var/lib/luma-os/content-store/v2-[0-9a-f]*/identity.json r,
  /var/lib/luma-os/content-store/v2-[0-9a-f]*/objects/ r,
  /var/lib/luma-os/content-store/v2-[0-9a-f]*/objects/[0-9a-f][0-9a-f]/ r,
  /var/lib/luma-os/content-store/v2-[0-9a-f]*/objects/[0-9a-f][0-9a-f]/[0-9a-f][0-9a-f]/ r,
  /var/lib/luma-os/content-store/v2-[0-9a-f]*/objects/[0-9a-f][0-9a-f]/[0-9a-f][0-9a-f]/[0-9a-f]* r,
  # Core root-member validation enumerates the actual held namespace OFD.
  owner /proc/@{pid}/fd/ r,
  owner /proc/@{pid}/fd/[0-9]* r,
  /proc/cmdline r,
  /proc/@{pid}/{stat,status,cgroup} r,
  /proc/@{pid}/attr/current r,
  /sys/ r,
  /sys/kernel/ r,
  /sys/kernel/security/ r,
  /sys/kernel/security/apparmor/ r,
  /sys/kernel/security/apparmor/features/ r,
  /sys/kernel/security/apparmor/features/network/ r,
  /sys/kernel/security/apparmor/features/network/af_unix r,
  /sys/fs/cgroup/system.slice/luma-content-data-observer.service/{memory.max,memory.swap.max,pids.max,cpu.max} r,
  /run/ r,
  /run/luma-content-data-observer/ rw,
  /run/luma-content-data-observer/read.sock rw,
  /dev/{random,urandom} r,
  /dev/{null,zero} rw,
  unix (create) type=stream,
  # Pathname socket bind is confined by the single exact writable path above;
  # AppArmor's AF_UNIX addr selector applies to abstract/unnamed addresses.
  unix (bind,listen,accept) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream,
  unix (send,receive) type=stream peer=(label=luma-content-custody),
  deny unix (bind,listen,accept) addr=@**,
  deny unix (connect,send,receive) peer=(addr=@**),
  deny network inet,
  deny network inet6,
  deny ptrace (trace,tracedby),
  signal (receive) peer=unconfined,
  deny /var/lib/luma-os/** wklmx,
  deny /var/lib/luma-os/{admin,identity,principals,models,model-packs,resource-checkpoint,content-checkpoint,content-restore-jobs,utc-windows,utc-windows-checkpoint}/** r,
  deny /var/lib/luma-broker/** rwklmx,
  deny /run/{luma-admin,luma-governance,luma-broker,luma-content-custody,luma-content-checkpoint,luma-resource-checkpoint}/** rwklmx,
  deny /etc/{passwd,group,shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /efi/** rwklmx,
  deny /boot/** rwklmx,
  deny /dev/log rw,
  deny /{,var/}run/uuidd/request rw,
  deny /{,var/}run/systemd/journal/{dev-log,socket,stdout} rw,
}
