#include <tunables/global>
profile luma-editor flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  deny ptrace (trace, tracedby),
  deny ptrace (readby) peer=luma-editor,
  deny ptrace (readby) peer=unconfined,
  ptrace (readby) peer=luma-broker,
  signal (receive) peer=luma-broker,
  signal (receive) peer=unconfined,
  unix (create) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream addr=none,
  unix (connect,send,receive) type=stream addr=none peer=(label=luma-broker),
  deny unix (bind,listen,accept) addr=@**,
  deny unix (connect,send,receive) peer=(addr=@**),
  deny network inet,
  deny network inet6,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /proc/cmdline r,
  /proc/meminfo r,
  /proc/sys/kernel/random/boot_id r,
  owner /proc/@{pid}/{stat,status,cgroup,cmdline,limits,mountinfo} r,
  owner /proc/@{pid}/attr/current r,
  owner /proc/@{pid}/fd/ r,
  owner /proc/@{pid}/fd/[0-9]* r,
  /sys/fs/cgroup/** r,
  /sys/dev/block/** r,
  /sys/devices/** r,
  /run/luma-broker/control.sock rw,
  / r,
  /var/ r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  deny /dev/tty rw,
  deny /dev/pts/** rw,
  deny /dev/log rw,
  deny /{,var/}run/systemd/journal/{dev-log,socket,stdout} rw,
  deny /var/lib/luma-os/** rwklmx,
  deny /var/lib/luma-broker/** rwklmx,
  deny /run/{luma-admin,luma-resource-checkpoint,luma-content-checkpoint}/** rwklmx,
  deny /etc/{passwd,group,shadow,gshadow} rwklx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
}
