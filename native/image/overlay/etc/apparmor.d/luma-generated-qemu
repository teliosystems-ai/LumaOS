#include <tunables/global>

profile luma-generated-qemu flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  # No networking, capabilities, ptrace, host disks/TPM/mounts, executable
  # generated payloads or writable persistent state are admitted here.
  deny capability,
  deny network,
  deny mount,
  deny ptrace,
  /usr/bin/qemu-system-x86_64 mr,
  /usr/lib/** mr,
  /lib/** mr,
  /usr/share/qemu/** r,
  /usr/share/seabios/** r,
  /etc/ld.so.cache r,
  /proc/self/fd/[0-9]* r,
  /proc/[0-9]*/fd/[0-9]* r,
  /proc/self/{stat,status,auxv,maps,limits} r,
  /proc/[0-9]*/{stat,status,auxv,maps,limits} r,
  /sys/devices/system/cpu/** r,
  /dev/kvm rw,
  /memfd:luma-generated-kernel r,
  /memfd:luma-generated-initrd r,
  signal (receive) set=(kill,term) peer=luma-acquisition,
  signal (receive) set=(kill,term) peer=unconfined,
  signal (send,receive) peer=luma-generated-qemu,
}
