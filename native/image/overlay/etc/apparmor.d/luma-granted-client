#include <tunables/global>
profile luma-granted-client flags=(attach_disconnected) {
  #include <abstractions/base>
  / r,
  /usr/ r,
  /usr/{lib,libexec,share}/ r,
  /usr/libexec/luma-os/ r,
  /usr/lib/systemd/ r,
  /usr/lib/systemd/system/ r,
  /usr/share/luma-os/ r,
  /etc/ r,
  /etc/apparmor.d/ r,
  /run/ r,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/luma-auth-helper mrix,
  /usr/sbin/unix_chkpwd mrix,
  /usr/bin/systemd-creds mrix,
  /usr/bin/systemd-run ix,
  /usr/bin/systemctl ix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/apparmor.d/luma-granted-client r,
  /etc/pam.d/** r,
  /etc/{passwd,shadow,group,gshadow,nsswitch.conf,login.defs} r,
  /etc/security/** r,
  /proc/cmdline r,
  /proc/sys/kernel/random/boot_id r,
  owner /proc/@{pid}/** r,
  /proc/@{pid}/{stat,status,cgroup,limits,attr/current} r,
  /proc/ r,
  /proc/@{pid}/task/ r,
  /proc/@{pid}/task/@{pid}/status r,
  /proc/1/comm r,
  /proc/self/ns/pid r,
  /proc/[0-9]*/ns/pid r,
  /proc/meminfo r,
  /sys/fs/cgroup/** r,
  /sys/dev/block/** r,
  /sys/devices/** r,
  /usr/share/luma-os/** r,
  /usr/lib/systemd/system/luma-utc-keeper.service r,
  /etc/apparmor.d/luma-utc-keeper r,
  /sys/fs/cgroup/system.slice/luma-utc-keeper.service/** r,
  /var/lib/luma-os/principals/ r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-broker/ r,
  /var/lib/luma-os/model.lock rwk,
  /var/lib/luma-os/model-runtime.lock rk,
  /var/lib/luma-os/principals/registry.json r,
  /var/lib/luma-os/identity/ r,
  /var/lib/luma-os/identity/{passwd,shadow,group,gshadow} r,
  /var/lib/luma-os/admin/ r,
  /var/lib/luma-os/admin/{anchor.json,nv-auth.cred,parent.name,enrollment.json,bootstrap.json,journal.json} r,
  /var/lib/luma-os/admin/journal.lock rwk,
  /var/lib/luma-os/admin/event-*.json r,
  /var/lib/luma-os/{model-selection.json,model-auth/**,model-activation*,model-rollback.json,model-quarantine.json} r,
  /run/luma-admin/ rw,
  /run/luma-admin/** rwk,
  /run/systemd/tpm2-pcr-signature.json r,
  /run/luma-broker/control.sock rw,
  /run/luma-broker/ r,
  /run/luma-resource-checkpoint/ r,
  /run/luma-resource-checkpoint/authority.lock rwk,
  /var/lib/luma-os/resource-checkpoint/ r,
  /var/lib/luma-os/resource-checkpoint/sealed/ r,
  /var/lib/luma-os/resource-checkpoint/sealed/** r,
  /var/lib/luma-os/resource-checkpoint/paired/ r,
  /var/lib/luma-os/resource-checkpoint/paired/objects/ r,
  /var/lib/luma-os/resource-checkpoint/paired/head.json r,
  /run/luma-granted-client/ r,
  /run/luma-granted-client/requests/ r,
  /run/luma-granted-client/requests/*/ r,
  /run/luma-granted-client/requests/*/input.{json,csv} r,
  /run/luma-granted-client/payloads/ r,
  /run/luma-granted-client/payloads/*/ r,
  /run/luma-granted-client/payloads/*/output.sock rw,
  /run/systemd/private rw,
  /run/systemd/system/ r,
  /run/systemd/system/{luma-model,luma-broker,luma-acquisition}.service r,
  /run/dbus/system_bus_socket rw,
  /run/luma-utc-control/ r,
  /run/luma-utc-control/query.sock rw,
  /dev/tpmrm0 rw,
  /dev/{urandom,random} r,
  /dev/null rw,
  /dev/tty rw,
  /dev/pts/[0-9]* rw,
  /var/lib/luma-os/workflow-runs/ rw,
  /var/lib/luma-os/workflow-runs/** rwk,
  /var/lib/luma-os/artifacts/ rw,
  /var/lib/luma-os/artifacts/** rwk,
  /var/lib/luma-os/artifact-catalog/ rw,
  /var/lib/luma-os/artifact-catalog/** rwk,
  /var/lib/luma-os/artifact-catalog-domains/ rw,
  /var/lib/luma-os/artifact-catalog-domains/** rwk,
  /var/lib/luma-os/workflow-dags/ rw,
  /var/lib/luma-os/workflow-dags/** rwk,
  /var/lib/luma-os/workflow-invoice-domains/ rw,
  /var/lib/luma-os/workflow-invoice-domains/** rwk,
  /var/lib/luma-os/workflow-history/ rw,
  /var/lib/luma-os/workflow-history/** rwk,
  /var/lib/luma-os/workflow-inputs/ rwk,
  /var/lib/luma-os/workflow-inputs/*/ rw,
  /var/lib/luma-os/workflow-inputs/** r,
  /var/lib/luma-os/policy-decisions/ rw,
  /var/lib/luma-os/policy-decisions/** rwk,
  /var/lib/luma-broker/resources/ rw,
  /var/lib/luma-broker/resources/** rwkl,
  capability chown,
  /memfd:luma-private-credential rwkm,
  /memfd:luma-workflow-input rwk,
  /memfd:luma-workflow-output rwk,
  network unix stream,
  signal (send,receive) peer=luma-granted-client,
  signal (receive) peer=unconfined,
  deny /var/lib/luma-os/{models,reference}/** rwklx,
  deny /dev/{mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
}
