#include <tunables/global>

profile luma-hardware flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  deny ptrace (trace,tracedby),
  deny ptrace (readby) peer=unconfined,
  ptrace (readby) peer=luma-broker,
  ptrace (readby) peer=luma-hardware-query,
  ptrace (readby) peer=luma-hardware-daemon-observer,
  ptrace (read) peer=luma-hardware-query,
  ptrace (read) peer=luma-hardware-daemon-observer,
  signal (send,receive) peer=luma-hardware,
  signal (receive) peer=unconfined,
  network unix stream,
  dbus (send) bus=system path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={Hello,GetId,GetNameOwner,GetConnectionUnixProcessID,GetConnectionUnixUser}
       peer=(name=org.freedesktop.DBus label=unconfined),
  dbus (send) bus=system path=/org/freedesktop/UPower/PowerProfiles
       interface=org.freedesktop.DBus.Properties member={Get,Set}
       peer=(label=unconfined),
  dbus (send) bus=system path=/org/freedesktop/systemd1
       interface=org.freedesktop.systemd1.Manager member={GetUnit,SetUnitProperties}
       peer=(label=unconfined),
  dbus (send) bus=system path=/org/freedesktop/systemd1
       interface=org.freedesktop.DBus.Properties member=Get
       peer=(label=unconfined),
  dbus (send) bus=system path=/org/freedesktop/systemd1/unit/{lumamodel,lumaacquisition}_2eslice
       interface=org.freedesktop.DBus.Properties member=Get
       peer=(label=unconfined),
  dbus (receive) bus=system peer=(label=unconfined),
  unix (getopt,setopt) type=seqpacket,
  unix (connect,send,receive) type=seqpacket peer=(label=luma-hardware-query),
  unix (connect,send,receive) type=seqpacket peer=(label=luma-hardware-daemon-observer),
  # Activation listeners belong to PID1; actual replies are independently
  # authenticated using kernel-attached credentials and process descriptors.
  unix (connect,send,receive) type=seqpacket peer=(label=unconfined),
  / r,
  /usr/ r,
  /usr/{lib,libexec,share}/ r,
  /usr/libexec/luma-os/ r,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/luma-auth-helper mrix,
  /usr/libexec/luma-os/hardware-{bpf-query,daemon-observer} r,
  /usr/libexec/luma-os/hardware_writer_verify.py r,
  /usr/libexec/power-profiles-daemon r,
  /usr/bin/dbus-daemon r,
  /usr/bin/python3{,.12} mrix,
  /usr/bin/systemd-creds mrix,
  /usr/bin/openssl mrix,
  /usr/sbin/unix_chkpwd mrix,
  /{usr/,}lib{,64}/** mr,
  /usr/share/luma-os/** r,
  /usr/share/dbus-1/** r,
  /usr/share/polkit-1/** r,
  /etc/ r,
  /etc/apparmor.d/ r,
  /etc/apparmor.d/luma-{hardware,utc-keeper} r,
  /etc/{passwd,shadow,group,gshadow,nsswitch.conf,login.defs} r,
  /etc/pam.d/** r,
  /etc/security/** r,
  /etc/dbus-1/** r,
  /etc/polkit-1/** r,
  /etc/udev/** r,
  /proc/ r,
  /proc/cmdline r,
  /proc/{cpuinfo,meminfo} r,
  /proc/sys/kernel/{random/boot_id,osrelease} r,
  owner /proc/@{pid}/** r,
  /proc/@{pid}/{stat,status,cgroup,cmdline,exe,limits} r,
  /proc/@{pid}/fdinfo/* r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/task/ r,
  /proc/@{pid}/task/@{pid}/status r,
  /proc/1/comm r,
  /proc/self/ns/pid r,
  /proc/@{pid}/ns/pid r,
  /sys/ r,
  /sys/fs/cgroup/** r,
  /sys/fs/cgroup/{lumamodel,lumaacquisition}.slice/{cpu.max,cpu.weight,memory.max,io.max} rw,
  /sys/dev/block/** r,
  /sys/devices/** r,
  /sys/class/backlight/ r,
  /sys/class/backlight/intel_backlight r,
  /sys/class/backlight/intel_backlight/** r,
  /sys/devices/pci*/**/drm/card[0-9]*/card[0-9]*-eDP-[0-9]*/intel_backlight/brightness rw,
  /sys/bus/pci/drivers/i915/ r,
  /sys/firmware/efi/efivars/{SecureBoot,SetupMode}-8be4df61-93ca-11d2-aa0d-00e098032b8c r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/principals/ r,
  /var/lib/luma-os/principals/registry.json r,
  /var/lib/luma-os/identity/ r,
  /var/lib/luma-os/identity/{passwd,shadow,group,gshadow} r,
  /var/lib/luma-os/admin/ rw,
  /var/lib/luma-os/admin/{anchor.json,nv-auth.cred,parent.name,enrollment.json,bootstrap.json} r,
  /var/lib/luma-os/admin/{journal.json,journal.pending.json,journal.pending.new-*,journal.lock,event-*.json} rwk,
  /var/lib/luma-os/model.lock rwk,
  /var/lib/luma-os/model-runtime.lock rwk,
  /var/lib/luma-os/model-* r,
  /var/lib/luma-os/models/ r,
  /var/lib/luma-os/models/** r,
  /var/lib/luma-os/model-packs/ r,
  /var/lib/luma-os/model-packs/** r,
  /var/lib/luma-os/model-qualifications/ r,
  /var/lib/luma-os/model-qualifications/** r,
  /var/lib/luma-os/policy-decisions/ rw,
  /var/lib/luma-os/policy-decisions/** rwk,
  /run/ r,
  /run/luma-admin/ rw,
  /run/luma-admin/** rwk,
  /run/luma-hardware/ rw,
  /run/luma-hardware/worker-{model,acquisition}.lock rwk,
  /run/luma-hardware/query.sock rw,
  /run/luma-hardware/requests/ r,
  /run/luma-hardware/requests/*/ r,
  /run/luma-hardware/requests/*/input.json r,
  /run/luma-hardware-daemon-observer/ r,
  /run/luma-hardware-daemon-observer/observe.sock rw,
  /run/luma-broker/ r,
  /run/luma-broker/control.sock rw,
  /run/luma-peer-observer/ r,
  /run/luma-peer-observer/credentials.sock rw,
  /run/luma-utc-control/ r,
  /run/luma-utc-control/query.sock rw,
  /run/dbus/ r,
  /run/dbus/system_bus_socket rw,
  /run/systemd/tpm2-pcr-signature.json r,
  /usr/lib/systemd/system/luma-utc-keeper.service r,
  /memfd:luma-private-credential rwkm,
  /memfd:luma-release-{root,key,message,signature} rwk,
  /memfd:luma-model-{root,key,message,signature} rwk,
  /dev/tpmrm0 rw,
  /dev/{urandom,random} r,
  /dev/null rw,
  /dev/tty rw,
  /dev/pts/[0-9]* rw,
  deny /proc/@{pid}/{mem,environ} rw,
  deny /dev/{mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
  deny /var/lib/luma-os/models/** wklx,
}
