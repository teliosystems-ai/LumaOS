#include <tunables/global>

profile luma-hardware-daemon-observer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  capability sys_ptrace,
  ptrace (read) peer=luma-hardware,
  ptrace (read) peer=unconfined,
  ptrace (readby) peer=luma-hardware,
  deny ptrace (trace, tracedby),
  signal (receive) peer=unconfined,
  unix (getopt) type=seqpacket,
  unix (receive,send) type=seqpacket peer=(label=luma-hardware),
  /usr/libexec/luma-os/hardware-daemon-observer mr,
  /usr/libexec/luma-os/luma-platform r,
  /usr/lib/systemd/systemd r,
  /usr/bin/dbus-daemon r,
  /usr/libexec/power-profiles-daemon r,
  /{usr/,}lib{,64}/** mr,
  /etc/ssl/openssl.cnf r,
  /etc/passwd r,
  /proc/@{pid}/{stat,status,cgroup,cmdline,exe} r,
  /proc/@{pid}/attr/current r,
  owner /proc/@{pid}/fd/[0-9]* r,
  owner /proc/@{pid}/fdinfo/[0-9]* r,
  /proc/sys/kernel/random/boot_id r,
  deny /proc/@{pid}/{mem,environ} rw,
  deny /dev/tpm* rw,
  deny /var/lib/luma-os/** rwklx,
  deny /run/luma-admin/** rwklx,
  deny /run/luma-governance/** rwklx,
  deny /sys/** w,
}
