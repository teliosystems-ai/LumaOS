#include <tunables/global>
profile luma-hosted-compute flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /proc/ r,
  /proc/[0-9]*/{status,cgroup,limits,stat} r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[01] rw,
  /sys/fs/cgroup/lumahosted.slice/luma-hosted-compute.service/ r,
  /sys/fs/cgroup/lumahosted.slice/luma-hosted-compute.service/{memory.max,memory.swap.max,pids.max,cpu.max,cgroup.procs} r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  signal (receive) peer=unconfined,
  deny network,
  deny /dev/log rw,
  deny /{,var/}run/uuidd/request rw,
  deny /{,var/}run/systemd/journal/{dev-log,socket,stdout} rw,
  deny /run/user/** rwklmx,
  deny /mnt/** rwklmx,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /var/lib/luma-os/** rwklmx,
  deny /etc/{shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
}
