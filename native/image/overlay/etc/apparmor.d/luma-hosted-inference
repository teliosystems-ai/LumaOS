#include <tunables/global>
profile luma-hosted-inference flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/hosted-llama/ r,
  /usr/libexec/luma-os/hosted-llama/llama-completion mrix,
  /usr/libexec/luma-os/hosted-llama/*.so{,.*} mr,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/luma-os/hosted-inference{,-runtime}.json r,
  /usr/share/luma-os/models/qwen3-4b-q4-k-m.gguf rm,
  /proc/ r,
  /proc/cpuinfo r,
  /proc/meminfo r,
  /proc/[0-9]*/{status,cgroup,limits,stat} r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* rwm,
  /memfd:luma-hosted-prompt rw,
  /memfd:luma-hosted-{output,diagnostics} rw,
  /var/lib/luma-hosted-revocations/ r,
  /var/lib/luma-hosted-revocations/[0-9a-f]* r,
  /sys/devices/system/cpu/** r,
  /sys/fs/cgroup/lumahosted.slice/luma-hosted-inference.service/ r,
  /sys/fs/cgroup/lumahosted.slice/luma-hosted-inference.service/{memory.max,memory.swap.max,pids.max,cpu.max,cgroup.procs} r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  signal (send,receive) peer=luma-hosted-inference,
  signal (receive) peer=unconfined,
  deny network,
  deny /dev/log rw,
  deny /{,var/}run/uuidd/request rw,
  deny /{,var/}run/systemd/journal/{dev-log,socket,stdout} rw,
  deny /run/user/** rwklmx,
  deny /mnt/** rwklmx,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /var/lib/luma-os/** rwklmx,
  deny /etc/{shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
}
