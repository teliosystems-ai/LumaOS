#include <tunables/global>
profile luma-hosted-workspace-bootstrap flags=(attach_disconnected,mediate_deleted) {
  /proc/meminfo r,
  #include <abstractions/base>
  capability chown,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/luma-workspace-auth-helper mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/luma-os/hosted-workspace{,-runtime}.json r,
  /usr/share/luma-os/hosted-workspace/accounts/{passwd,group,shadow,gshadow} r,
  /etc/ r,
  /etc/{passwd,group,shadow,gshadow} rw,
  /etc/.luma-workspace-{passwd,group,shadow,gshadow} rw,
  /etc/pam.d/luma-admin r,
  /etc/nsswitch.conf r,
  /var/lib/ r,
  /var/lib/luma-hosted-workspace/ rwk,
  /var/lib/luma-hosted-workspace/** rwk,
  /var/lib/luma-hosted-revocations/ r,
  /var/lib/luma-hosted-revocations/[0-9a-f]* r,
  /home/ r,
  /home/[a-z]*/ rw,
  /proc/ r,
  /proc/1/comm r,
  /proc/sys/kernel/osrelease r,
  /proc/[0-9]*/{status,cgroup,limits,stat} r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* rwm,
  /proc/[0-9]*/exe r,
  /memfd:luma-private-credential rwm,
  /sys/fs/cgroup/lumahosted.slice/luma-hosted-workspace-bootstrap.service/ r,
  /sys/fs/cgroup/lumahosted.slice/luma-hosted-workspace-bootstrap.service/{memory.max,memory.swap.max,pids.max,cpu.max,cgroup.procs} r,
  /dev/{null,zero,tty} rw,
  /dev/pts/[0-9]* rw,
  /dev/{random,urandom} r,
  signal (send,receive) peer=luma-hosted-workspace-bootstrap,
  signal (receive) peer=unconfined,
  deny network,
  deny /dev/log rw,
  deny /{,var/}run/uuidd/request rw,
  deny /{,var/}run/systemd/journal/{dev-log,socket,stdout} rw,
  deny /run/user/** rwklmx,
  deny /mnt/** rwklmx,
  deny /root/** rwklmx,
  deny /var/lib/luma-os/** rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
}
