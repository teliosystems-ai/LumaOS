#include <tunables/global>

profile luma-installer-model-stage flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  capability setuid,
  capability setgid,
  capability kill,
  capability sys_ptrace,
  ptrace (read) peer=unconfined,
  ptrace (read, readby) peer=luma-installer-model-stage,
  signal (send, receive) peer=luma-installer-model-stage,
  signal (send) set=(kill) peer=luma-installer-model-fetch,
  signal (receive) peer=unconfined,
  network unix stream,
  network inet stream,
  network inet6 stream,

  /usr/libexec/luma-os/luma-platform mrix,
  /usr/bin/{openssl,lsblk} mrix,
  /usr/bin/curl mrpx -> &luma-installer-model-fetch,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/ssl/** r,
  /usr/share/ca-certificates/** r,
  /memfd:luma-release-{key,message,signature} rw,

  /proc/cmdline r,
  /proc/meminfo r,
  /proc/mounts r,
  /proc/sys/kernel/random/boot_id r,
  /proc/@{pid}/{stat,status,cmdline,cgroup,mountinfo,limits,exe} r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/fd/ r,
  /proc/@{pid}/fd/[0-9]* r,
  /proc/@{pid}/fdinfo/[0-9]* r,
  deny /proc/@{pid}/{mem,environ} rw,
  deny /proc/@{pid}/task/@{pid}/mem rw,
  /sys/class/block/** r,
  /sys/block/** r,
  /sys/devices/** r,
  /sys/dev/block/** r,
  /sys/fs/cgroup/lumainstallerstage.slice/** r,
  /run/udev/data/** r,
  /run/luma-disk-locks/ r,
  /run/luma-disk-locks/* rk,
  /run/luma-installer-model-stage.lock rk,
  /dev/{sd*,vd*,xvd*,nvme*,dm-*} r,

  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/staging/ r,
  /var/lib/luma-os/staging/install-*/ r,
  /var/lib/luma-os/staging/install-*/model-*.json r,
  /var/lib/luma-os/staging/install-*/root/ r,
  /var/lib/luma-os/staging/install-*/root/usr/ r,
  /var/lib/luma-os/staging/install-*/root/usr/share/ r,
  /var/lib/luma-os/staging/install-*/root/usr/share/luma-os/ r,
  /var/lib/luma-os/staging/install-*/root/usr/share/luma-os/** r,
  /var/lib/luma-os/staging/install-*/data/ r,
  /var/lib/luma-os/staging/install-*/data/lib/ r,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/ r,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/principals/ r,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/principals/registry.json r,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/model.lock rwk,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/models/ rw,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/models/* rwk,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/model-packs/ rw,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/model-packs/** rwk,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/installer-model-staging/ rw,
  /var/lib/luma-os/staging/install-*/data/lib/luma-os/installer-model-staging/* rwk,

  deny /etc/{shadow,gshadow} r,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /var/lib/luma-os/{admin,model-qualifications}/** rwklmx,
  deny /var/lib/luma-broker/** rwklmx,
  deny /run/luma-{admin,governance,broker}/** rwklmx,
  deny /efi/** rwklmx,
  deny /boot/** rwklmx,
}
