#include <tunables/global>
profile luma-model flags=(attach_disconnected) {
  #include <abstractions/base>
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/llama/ r,
  /usr/libexec/luma-os/llama/** mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /proc/cmdline r,
  /proc/meminfo r,
  /proc/@{pid}/cgroup r,
  /proc/cpuinfo r,
  /proc/sys/kernel/random/boot_id r,
  owner /proc/@{pid}/** r,
  /sys/devices/system/cpu/** r,
  /sys/devices/system/node/** r,
  /sys/fs/cgroup/**/memory.max r,
  /sys/fs/cgroup/memory.max r,
  /var/lib/luma-os/model-selection.json r,
  /var/lib/luma-os/model-activation.pending r,
  /var/lib/luma-os/model-runtime.lock rk,
  /var/lib/luma-os/models/*.gguf mr,
  /var/lib/luma-os/model-auth/api-key r,
  owner /tmp/** rwk,
  /dev/urandom r,
  /dev/null rw,
  network inet stream,
  network unix stream,
  deny /dev/{mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
  deny /var/lib/luma-os/identity/** rwklx,
}
