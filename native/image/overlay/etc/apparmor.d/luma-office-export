#include <tunables/global>

profile luma-office-export flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  capability chown,
  capability setuid,
  capability setgid,
  capability kill,
  ptrace (readby) peer=luma-broker,
  signal (receive) peer=luma-broker,
  signal (receive) peer=unconfined,
  signal (send) set=(kill) peer=luma-office-convert,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/bin/bwrap mrpx -> luma-office-convert,
  /usr/lib/** mr,
  /lib/** mr,
  /usr/share/luma-os/adapters/ r,
  /usr/share/luma-os/adapters/office-pdf-v1.json r,
  /usr/share/luma-os/release-identity.json r,
  /var/lib/luma-os/principals/ r,
  /var/lib/luma-os/principals/registry.json r,
  /var/lib/luma-os/content-store/ rk,
  /var/lib/luma-os/content-store/** rk,
  /run/luma-office-export/ rw,
  /run/luma-office-export/** rwkl,
  /run/luma-broker/control.sock rw,
  /run/luma-content-custody/control.sock rw,
  /memfd:luma-content-office-request r,
  /memfd:luma-content-office-output rw,
  /proc/cmdline r,
  /proc/sys/kernel/random/boot_id r,
  /proc/meminfo r,
  /proc/[0-9]*/{stat,status,cgroup,cmdline,limits} r,
  /proc/[0-9]*/attr/current r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  /sys/fs/cgroup/** r,
  /sys/dev/block/** r,
  /sys/devices/** r,
  /sys/kernel/security/ r,
  /sys/kernel/security/apparmor/ r,
  /sys/kernel/security/apparmor/features/ r,
  /sys/kernel/security/apparmor/features/network/ r,
  /sys/kernel/security/apparmor/features/network/af_unix r,
  unix (create) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream,
  unix (connect,send,receive) type=stream peer=(label=luma-broker),
  unix (connect,send,receive) type=stream peer=(label=luma-content-custody),
  deny network inet,
  deny network inet6,
  deny /dev/tpm{,rm}[0-9]* rwklmx,
  deny /var/lib/luma-os/{admin,identity,resource-checkpoint,content-checkpoint}/** rwklmx,
  deny /run/luma-{admin,resource-checkpoint,content-checkpoint}/** rwklmx,
}

# Only the fixed no-new-privileges UID986 child enters this namespace builder.
# Namespace mount capabilities here never confer host capabilities: the parent
# drops all real/effective/saved credentials before exec and bwrap drops all
# namespace capabilities before the actual LibreOffice executable runs.
profile luma-office-convert flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  userns,
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  mount,
  umount,
  pivot_root,
  signal (receive) peer=luma-office-export,
  signal (send,receive) peer=luma-office-convert,
  /usr/bin/bwrap mrix,
  /usr/lib/libreoffice/program/soffice.bin mrix,
  /usr/** mr,
  /lib{,64}/** mr,
  /etc/fonts/** r,
  /etc/libreoffice/** r,
  /run/luma-office-export/ r,
  /run/luma-office-export/** rwkl,
  /input/ r,
  /input/document.html r,
  /output/ rw,
  /output/** rwkl,
  /tmp/ rw,
  /tmp/** rwkl,
  /home/office/ rw,
  /home/office/** rwkl,
  /proc/** r,
  /dev/{null,zero,random,urandom} rw,
  /dev/shm/ rw,
  /dev/shm/** rwkl,
  unix,
  deny network inet,
  deny network inet6,
  deny /dev/tpm{,rm}[0-9]* rwklmx,
  deny /run/luma-{broker,content-custody,admin,resource-checkpoint,content-checkpoint}/** rwklmx,
  deny /var/lib/luma-os/** rwklmx,
}
