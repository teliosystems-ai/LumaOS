#include <tunables/global>

profile luma-qa-supervisor flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  capability chown,
  capability setuid,
  capability setgid,
  capability kill,
  capability setpcap,
  capability sys_ptrace,
  ptrace (read) peer=luma-model-qa,
  ptrace (read, readby) peer=luma-qa-supervisor,
  ptrace (readby) peer=luma-broker,
  signal (receive) peer=luma-broker,
  signal (send) set=(kill) peer=luma-model-qa,
  signal (receive) peer=unconfined,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/llama/llama-server mrpx -> &luma-model-qa,
  /usr/libexec/luma-os/llama/ r,
  /usr/libexec/luma-os/llama/*.so* mr,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/luma-os/models/ r,
  /usr/share/luma-os/models/** r,
  /usr/share/luma-os/model-packs/ r,
  /usr/share/luma-os/model-packs/** r,
  /proc/cmdline r,
  /proc/net/tcp r,
  /proc/meminfo r,
  /proc/cpuinfo r,
  /proc/sys/kernel/random/boot_id r,
  /proc/[0-9]*/{stat,status,cgroup,limits} r,
  /proc/[0-9]*/exe r,
  /proc/[0-9]*/fd/ r,
  /proc/[0-9]*/fd/[0-9]* r,
  /proc/[0-9]*/attr/current r,
  /sys/fs/cgroup/** r,
  /sys/devices/** r,
  /sys/dev/block/** r,
  /var/lib/luma-os/models/*.gguf mr,
  /var/lib/luma-os/model-packs/** r,
  /run/luma-model-qa/ r,
  /run/luma-model-qa/*/ r,
  /run/luma-model-qa/*/input.json r,
  /run/luma-model-qa/*/report.json rw,
  /run/luma-broker/control.sock rw,
  /memfd:luma-qa-key rw,
  /dev/urandom r,
  /dev/null rw,
  network inet stream,
  network unix stream,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
  deny /var/lib/luma-os/admin/** rwklx,
  deny /var/lib/luma-os/identity/** rwklx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
}
