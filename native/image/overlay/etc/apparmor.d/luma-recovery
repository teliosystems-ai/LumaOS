#include <tunables/global>
profile luma-recovery flags=(attach_disconnected) {
  #include <abstractions/base>
  # Only the fixed machine adapter can enter this profile. The UTC supervisor
  # is a separate transition and cannot read target custody or block devices.
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/bin/{lsblk,udevadm,mount,umount,openssl,systemd-creds} mrix,
  /usr/sbin/{cryptsetup,dmsetup,veritysetup,blockdev} mrix,
  /usr/libexec/luma-os/luma-utc-recovery-restart Px -> luma-utc-recovery-restart,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  / r,
  /usr/ r,
  /usr/{lib,libexec,share}/ r,
  /usr/libexec/luma-os/ r,
  /usr/lib/systemd/ r,
  /usr/lib/systemd/system/ r,
  /usr/share/luma-os/ r,
  /usr/share/luma-os/{release.pub,production-release-root.pub,release-identity.json,admin-pcr-public.pem} r,
  /usr/share/luma-os/utc/** r,
  /usr/lib/systemd/system/luma-utc-*.service r,
  /etc/ r,
  /etc/apparmor.d/ r,
  /etc/apparmor.d/luma-{recovery,utc-*} r,
  /etc/{mtab,fstab,nsswitch.conf,passwd,group} r,
  /proc/cmdline r,
  /proc/sys/kernel/random/boot_id r,
  /proc/@{pid}/{status,stat,cmdline,environ,maps,auxv,cgroup,attr/current,mountinfo,mounts} r,
  /proc/@{pid}/task/ r,
  /proc/@{pid}/task/@{pid}/{status,attr/current} r,
  /proc/@{pid}/{exe,root} r,
  owner /proc/@{pid}/fd/** rw,
  owner /proc/@{pid}/fdinfo/** r,
  /proc/{meminfo,partitions,devices,filesystems} r,
  /sys/dev/block/** r,
  /sys/devices/** r,
  /sys/class/block/** r,
  /sys/fs/cgroup/** r,
  /sys/firmware/efi/efivars/{SecureBoot,SetupMode}-8be4df61-93ca-11d2-aa0d-00e098032b8c r,
  /dev/ r,
  /dev/disk/** r,
  /dev/{sd*,nvme*,vd*,dm-*} rw,
  /dev/mapper/ r,
  /dev/mapper/{control,luma-recovery-*} rw,
  /dev/tpmrm0 rw,
  /dev/{urandom,random} r,
  /dev/{null,tty,console} rw,
  /run/ r,
  /run/udev/** r,
  /run/cryptsetup/ rw,
  /run/cryptsetup/** rwk,
  /run/systemd/tpm2-pcr-signature.json r,
  /run/luma-admin/ rw,
  /run/luma-admin/anchor.lock rwk,
  /run/luma-disk-locks/ rw,
  /run/luma-disk-locks/[0-9]*-[0-9]* rwk,
  /run/luma-governance/ rw,
  /run/luma-governance/** rw,
  /run/luma-utc-control/ r,
  /run/luma-utc-control/{query,control}.sock rw,
  /media/ r,
  /media/luma/** r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/staging/ rw,
  /var/lib/luma-os/staging/target-recovery-*/ rw,
  /var/lib/luma-os/staging/target-recovery-*/data/ rw,
  /var/lib/luma-os/staging/target-recovery-*/data/lib/ r,
  /var/lib/luma-os/staging/target-recovery-*/data/lib/luma-os/ r,
  /var/lib/luma-os/staging/target-recovery-*/data/lib/luma-os/admin/** r,
  /var/lib/luma-os/staging/target-recovery-*/data/lib/luma-os/principals/{,registry.json} r,
  /var/lib/luma-os/staging/target-recovery-*/data/lib/luma-os/installed.json r,
  /var/lib/luma-os/staging/target-esp-*/ rw,
  /var/lib/luma-os/staging/target-esp-*/esp/ rw,
  /var/lib/luma-os/staging/target-esp-*/esp/EFI/ rw,
  /var/lib/luma-os/staging/target-esp-*/esp/EFI/{BOOT,Linux}/** rw,
  /var/lib/luma-os/staging/target-esp-*/esp/loader/** rw,
  /var/lib/luma-os/staging/verified-v1/ rw,
  /var/lib/luma-os/staging/verified-v1/lock rwk,
  /var/lib/luma-os/staging/verified-v1/bundle-*/ rw,
  /var/lib/luma-os/staging/verified-v1/bundle-*/* rw,
  /memfd:luma-credential rw,
  /memfd:luma-private-credential rwkm,
  /memfd:luma-release-{root,key,message,signature} rwk,
  /run/luma-recovery-input/ r,
  /run/luma-recovery-input/*.json r,
  /run/luma-recovery-bundle/** r,
  capability sys_admin,
  capability dac_override,
  capability sys_rawio,
  mount /dev/mapper/luma-recovery-* -> /var/lib/luma-os/staging/target-recovery-*/data/,
  mount /dev/{sd*,nvme*,vd*} -> /var/lib/luma-os/staging/target-esp-*/esp/,
  umount /var/lib/luma-os/staging/target-recovery-*/data/,
  umount /var/lib/luma-os/staging/target-esp-*/esp/,
  network unix stream,
  network unix seqpacket,
  signal (send,receive) peer=luma-utc-recovery-restart,
  signal (receive) peer=unconfined,
  deny /etc/{shadow,gshadow} r,
  deny /dev/{mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /var/lib/luma-os/admin/** rwklx,
  deny /var/lib/luma-os/staging/target-recovery-*/data/** wklx,
  deny /var/lib/luma-os/{models,reference,artifacts}/** rwklx,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
}
