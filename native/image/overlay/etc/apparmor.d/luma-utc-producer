#include <tunables/global>
profile luma-utc-producer flags=(attach_disconnected) {
  #include <abstractions/base>
  /usr/libexec/luma-os/chronyd mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/luma-os/utc/** r,
  /usr/lib/systemd/system/luma-utc-producer.service r,
  /etc/apparmor.d/luma-utc-producer r,
  /etc/{passwd,group,nsswitch.conf,hosts,resolv.conf,gai.conf} r,
  /run/systemd/resolve/{stub-resolv.conf,resolv.conf} r,
  /proc/sys/kernel/random/boot_id r,
  /proc/sys/kernel/{osrelease,ostype,version} r,
  /var/lib/luma-os/identity/{passwd,group} r,
  owner /proc/@{pid}/** r,
  /run/luma-utc/ r,
  /run/luma-utc/measurements.sock w,
  /run/luma-utc-producer/ rw,
  /run/luma-utc-producer/chronyd.pid rw,
  /dev/{urandom,random} r,
  /dev/null rw,
  capability sys_time,
  ptrace (readby) peer=luma-utc-keeper,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  network unix dgram,
  signal (receive) peer=unconfined,
  deny /etc/{shadow,gshadow} r,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /var/lib/luma-os/identity/{shadow,gshadow} r,
  deny /var/lib/luma-os/{admin,principals,models,reference,artifacts}/** rwklx,
  deny /run/{luma-admin,luma-governance,luma-utc-control}/** rwklx,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
}
