#include <tunables/global>
profile luma-utc-recovery-keeper flags=(attach_disconnected) {
  #include <abstractions/base>
  / r,
  /usr/ r,
  /usr/lib/ r,
  /usr/lib/x86_64-linux-gnu/ r,
  /usr/libexec/ r,
  /usr/libexec/luma-os/ r,
  /usr/lib/systemd/ r,
  /usr/lib/systemd/system/ r,
  /usr/share/ r,
  /usr/share/luma-os/ r,
  /usr/share/luma-os/utc/ r,
  /etc/ r,
  /etc/apparmor.d/ r,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/share/luma-os/utc/** r,
  /usr/share/luma-os/release-identity.json r,
  /usr/libexec/luma-os/chronyd r,
  /usr/lib/systemd/system/luma-utc-*.service r,
  /etc/apparmor.d/luma-utc-{keeper,producer,recovery-keeper,recovery-producer} r,
  /etc/apparmor.d/luma-recovery r,
  /proc/cmdline r,
  /proc/sys/kernel/random/boot_id r,
  /sys/dev/block/*/dm/{name,uuid} r,
  /sys/devices/virtual/block/dm-*/dm/{name,uuid} r,
  /sys/firmware/efi/efivars/{SecureBoot,SetupMode}-8be4df61-93ca-11d2-aa0d-00e098032b8c r,
  /proc/@{pid}/{status,stat,cmdline,environ,maps,auxv,cgroup,attr/current,mountinfo} r,
  /proc/@{pid}/task/ r,
  /proc/@{pid}/task/@{pid}/{status,attr/current} r,
  /proc/@{pid}/{exe,root} r,
  /proc/@{pid}/root/usr/{lib/**,libexec/luma-os/chronyd,share/luma-os/utc/**} r,
  /proc/@{pid}/root/etc/apparmor.d/luma-utc-{producer,recovery-producer} r,
  owner /proc/@{pid}/fd/** rw,
  /run/ r,
  /run/luma-utc/ rw,
  /run/luma-utc/{measurements.sock,seed-ready} rw,
  /run/luma-utc-control/ rw,
  /run/luma-utc-control/{query,control}.sock rw,
  /dev/{urandom,random} r,
  /dev/null rw,
  capability chown,
  capability sys_time,
  capability sys_ptrace,
  ptrace (read) peer=luma-utc-recovery-producer,
  network unix stream,
  network unix dgram,
  signal (receive) peer=unconfined,
  deny /etc/{shadow,gshadow} r,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /var/lib/luma-os/** rwklx,
  deny /run/{luma-admin,luma-governance}/** rwklx,
  deny /run/luma-recovery/** rwklx,
  deny /efi/** rwklx,
  deny /boot/** rwklx,
}
