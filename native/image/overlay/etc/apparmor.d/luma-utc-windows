#include <tunables/global>

profile luma-utc-windows flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  deny ptrace (trace, tracedby),
  deny ptrace (readby) peer=luma-utc-windows,
  deny ptrace (readby) peer=unconfined,
  /usr/libexec/luma-os/luma-platform mrix,
  /usr/libexec/luma-os/luma-utc-windows-crypto rpx -> &luma-utc-windows-crypto,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  / r,
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/utc-windows/ r,
  /var/lib/luma-os/utc-windows/{journal.json,.pending.json,.next-journal.json,.key-draft.json} r,
  /var/lib/luma-os/utc-windows-checkpoint/ r,
  /var/lib/luma-os/utc-windows-checkpoint/genesis.json r,
  /var/lib/luma-os/utc-windows-checkpoint/sealed/ r,
  /var/lib/luma-os/utc-windows-checkpoint/sealed/{anchor.json,nv-auth.cred} r,
  /etc/ r,
  /etc/luma-os/ r,
  /etc/luma-os/utc-windows/ r,
  /etc/luma-os/utc-windows/transport.json r,
  /run/ r,
  /run/luma-utc-windows-checkpoint/ r,
  /run/luma-utc-windows-checkpoint/authority.lock rwk,
  /run/luma-utc-windows/ rw,
  /run/luma-utc-windows/control.sock rw,
  /run/luma-broker/control.sock rw,
  /run/systemd/ r,
  /run/systemd/tpm2-pcr-signature.json r,
  /usr/ r,
  /usr/share/ r,
  /usr/share/luma-os/ r,
  /usr/share/luma-os/{release-identity.json,admin-pcr-public.pem} r,
  /proc/cmdline r,
  /proc/@{pid}/{stat,status,cgroup,cmdline,mountinfo} r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/fdinfo/[0-9]* r,
  /sys/fs/cgroup/** r,
  /sys/kernel/security/apparmor/features/network/af_unix r,
  /dev/tpmrm0 rw,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  /memfd:luma-private-credential rwkm,
  unix (create) type=stream,
  unix (bind,listen,accept) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream addr=none,
  unix (send,receive) type=stream addr=none peer=(addr=none,label=luma-utc-windows),
  unix (send,receive) type=stream addr=none peer=(addr=none,label="luma-utc-windows//&luma-utc-windows-crypto"),
  unix (connect,send,receive) type=stream peer=(label=luma-broker),
  unix (send,receive) type=stream peer=(label=luma-utc-windows-front),
  deny unix (bind,listen,accept) addr=@**,
  deny unix (connect,send,receive) peer=(addr=@**),
  deny network inet,
  deny network inet6,
  ptrace (readby) peer=luma-broker,
  signal (receive) peer=unconfined,
  signal (send,receive) set=(kill) peer=luma-utc-windows,
  signal (send) set=(kill) peer="luma-utc-windows//&luma-utc-windows-crypto",
  deny /var/lib/luma-os/{admin,identity,principals,content-checkpoint,content-store,resource-checkpoint}/** rwklmx,
  deny /run/luma-admin/** rwklmx,
  deny /dev/{tpm0,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /dev/log rw,
}
