#include <tunables/global>

profile luma-utc-windows-front flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/bin/python3{,.12} mrix,
  /usr/libexec/luma-os/utc-windows-front.py r,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/ r,
  /usr/bin/ r,
  /usr/libexec/ r,
  /usr/libexec/luma-os/ r,
  /usr/share/ r,
  /usr/share/luma-os/ r,
  /usr/share/luma-os/utc/ r,
  /usr/share/luma-os/utc/windows-transport.json r,
  /etc/ r,
  /etc/luma-os/ r,
  /etc/luma-os/utc-windows/ r,
  /etc/luma-os/utc-windows/{transport.json,certificate.pem,private-key.pem} r,
  /run/ r,
  /run/luma-utc-windows/ r,
  /run/luma-utc-windows/control.sock rw,
  /proc/self/{stat,status,cgroup} r,
  /proc/@{pid}/fd/ r,
  /sys/fs/cgroup/system.slice/luma-utc-windows-front.service/{memory.max,memory.swap.max,pids.max} r,
  /sys/kernel/security/apparmor/features/network/af_unix r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  # AF_UNIX-only socket creation is separately enforced by systemd/seccomp.
  # INET permissions apply to systemd's already-open listener and accepted FDs.
  network inet stream,
  network inet6 stream,
  unix (create,getattr,getopt,setopt,shutdown) type=stream,
  unix (connect,send,receive) type=stream peer=(label=luma-utc-windows),
  deny unix (bind,listen,accept),
  deny unix (connect,send,receive) peer=(addr=@**),
  signal (receive) peer=unconfined,
  deny /var/lib/luma-os/** rwklmx,
  deny /run/luma-{admin,broker,content-custody,content-checkpoint,utc-windows-checkpoint}/** rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**} rw,
  deny /dev/log rw,
}
