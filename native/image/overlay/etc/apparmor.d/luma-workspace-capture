# Ordinary-user explicit input, not content/model/product authority.
# Audio and restricted-portal video cannot borrow one another's device access.
#include <tunables/global>

profile luma-workspace-capture-audio flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/bin/python3{,.12} rix,
  /usr/libexec/luma-os/workspace_capture.py r,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/{machine-id,nsswitch.conf,passwd,group} r,
  /etc/pulse/{client.conf,client.conf.d/,client.conf.d/**} r,
  /var/lib/dbus/machine-id r,
  # Final immutable aliases resolve to these public identity files only.
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/identity/ r,
  /var/lib/luma-os/identity/{passwd,group,machine-id} r,
  /proc/@{pid}/{stat,status,limits,maps} r,
  /proc/@{pid}/attr/current r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  owner /run/user/[0-9]*/pulse/native rw,
  owner /dev/shm/pulse-shm-* rwk,
  owner /memfd:pulseaudio* rwkm,
  unix (create) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream,
  # Pathname Unix sockets are mediated by the owner file rule above; the
  # extended unix addr selector accepts abstract, not filesystem, addresses.
  unix (connect,send,receive) type=stream,
  deny unix (bind,listen,accept),
  deny unix (connect,send,receive) peer=(addr=@**),
  signal (receive) peer=unconfined,
  signal (receive) peer=luma-workspace,
  deny network inet,
  deny network inet6,
  deny network netlink,
  deny network packet,
  deny dbus,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /mnt/** rwklmx,
  deny /var/lib/luma-os/** wklmx,
  deny /var/lib/luma-os/identity/{shadow,gshadow} rwklmx,
  deny /var/lib/luma-os/{admin,principals,resource-checkpoint,content-custody,content-store,models,model-packs,model-qualifications}{,/**} rwklmx,
  deny /var/lib/luma-broker{,/**} rwklmx,
  deny /run/luma-*/** rwklmx,
  deny /etc/{shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**,video*,snd/**} rw,
}

profile luma-workspace-capture-video flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/bin/python3{,.12} rix,
  /usr/libexec/luma-os/workspace_capture.py r,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/{machine-id,nsswitch.conf,passwd,group} r,
  /var/lib/dbus/machine-id r,
  # Final immutable aliases resolve to these public identity files only.
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/identity/ r,
  /var/lib/luma-os/identity/{passwd,group,machine-id} r,
  /proc/@{pid}/{stat,status,limits,maps} r,
  /proc/@{pid}/attr/current r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  owner /memfd:pipewire-memfd* rwkm,
  # Only the portal's already-open remote FD is inherited by this worker.
  unix (getattr,getopt,setopt,shutdown) type=stream,
  unix (send,receive) type=stream addr=none,
  deny unix (create,connect,bind,listen,accept),
  signal (receive) peer=unconfined,
  signal (receive) peer=luma-workspace,
  deny network inet,
  deny network inet6,
  deny network netlink,
  deny network packet,
  deny dbus,
  deny /run/user/** rwklmx,
  deny /dev/shm/pulse-shm-* rwklmx,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /mnt/** rwklmx,
  deny /var/lib/luma-os/** wklmx,
  deny /var/lib/luma-os/identity/{shadow,gshadow} rwklmx,
  deny /var/lib/luma-os/{admin,principals,resource-checkpoint,content-custody,content-store,models,model-packs,model-qualifications}{,/**} rwklmx,
  deny /var/lib/luma-broker{,/**} rwklmx,
  deny /run/luma-*/** rwklmx,
  deny /etc/{shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**,video*,snd/**} rw,
}
