# Ordinary-user reviewed rule-based rendering and separately consented output.
# Neither profile has microphone, model, content-store or publication authority.
#include <tunables/global>

profile luma-workspace-speech-render flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/libexec/luma-os/speech/luma-tts-render rix,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/lib/x86_64-linux-gnu/espeak-ng-data/** r,
  /proc/@{pid}/{status,stat,limits,maps} r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/fd/0 r,
  owner /memfd:luma-speech-text r,
  /dev/{null,zero} rw,
  /dev/urandom r,
  signal (receive) peer=unconfined,
  signal (receive) peer=luma-workspace,
  deny network,
  deny unix,
  deny dbus,
  deny /run/** rwklmx,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /mnt/** rwklmx,
  deny /var/lib/luma-os/** rwklmx,
  deny /etc/{shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**,video*,snd/**} rw,
}

profile luma-workspace-speech-play flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/bin/python3{,.12} rix,
  /usr/libexec/luma-os/workspace_speech.py r,
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /etc/{machine-id,nsswitch.conf,passwd,group} r,
  /etc/pulse/{client.conf,client.conf.d/,client.conf.d/**} r,
  /var/lib/dbus/machine-id r,
  # Final immutable aliases resolve to these public identity files only.
  /var/ r,
  /var/lib/ r,
  /var/lib/luma-os/ r,
  /var/lib/luma-os/identity/ r,
  /var/lib/luma-os/identity/{passwd,group,machine-id} r,
  /proc/@{pid}/{status,stat,limits,maps} r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/fd/0 r,
  owner /memfd:luma-speech-wave r,
  /dev/{null,zero} rw,
  /dev/{random,urandom} r,
  owner /run/user/[0-9]*/pulse/native rw,
  owner /dev/shm/pulse-shm-* rwk,
  owner /memfd:pulseaudio* rwkm,
  unix (create) type=stream,
  unix (getattr,getopt,setopt,shutdown) type=stream,
  unix (connect,send,receive) type=stream,
  deny unix (bind,listen,accept),
  deny unix (connect,send,receive) peer=(addr=@**),
  signal (receive) peer=unconfined,
  signal (receive) peer=luma-workspace,
  deny network inet,
  deny network inet6,
  deny network netlink,
  deny network packet,
  deny dbus,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /mnt/** rwklmx,
  # Other product reads remain default-denied; all product writes/maps/exec
  # remain explicitly denied, including the three public read-only files.
  deny /var/lib/luma-os/** wklmx,
  deny /var/lib/luma-os/identity/{shadow,gshadow} rwklmx,
  deny /var/lib/luma-os/{admin,principals,resource-checkpoint,content-custody,content-store,models,model-packs,model-qualifications}{,/**} rwklmx,
  deny /var/lib/luma-broker{,/**} rwklmx,
  deny /run/luma-*/** rwklmx,
  deny /etc/{shadow,gshadow} rwklmx,
  deny /dev/{tpm*,mem,kmem,port,kvm,dxg,nvidia*,dri/**,video*,snd/**} rw,
}
