[Unit]
Description=Luma native privileged platform broker
After=apparmor.service local-fs.target lumamodel.slice lumaacquisition.slice system-lumacustody.slice luma-resource-live.service
Requires=apparmor.service lumamodel.slice lumaacquisition.slice system-lumacustody.slice luma-resource-live.service
Before=luma-reference.service luma-boot-health.service

[Service]
Type=simple
ExecStart=/usr/libexec/luma-os/luma-platform broker
User=root
Group=luma-control
RuntimeDirectory=luma-broker
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
StateDirectory=luma-broker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
ReadOnlyPaths=/sys/fs/cgroup
ReadWritePaths=/sys/fs/cgroup/lumamodel.slice /sys/fs/cgroup/lumaacquisition.slice
ReadWritePaths=/sys/fs/cgroup/system.slice/system-lumacustody.slice/memory.max
ReadWritePaths=-/var/lib/luma-os/resource-checkpoint/paired
ReadWritePaths=/run/luma-resource-checkpoint/authority.lock
ReadWritePaths=/run/luma-admin
ReadWritePaths=/run/luma-hardware
ReadOnlyPaths=-/var/lib/luma-os/resource-checkpoint/sealed
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @memlock
LimitMEMLOCK=524288
SystemCallFilter=~@mount @raw-io @reboot @swap @obsolete @debug
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
AppArmorProfile=luma-broker
MemoryMax=128M
MemorySwapMax=0
TasksMax=32
CPUQuota=25%
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
