[Unit]
Description=Luma one-request fixed platform-daemon identity observer
After=apparmor.service
Requires=apparmor.service

[Service]
Type=exec
Slice=system.slice
ExecStart=/usr/libexec/luma-os/hardware-daemon-observer
User=root
Group=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=LC_ALL=C
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=
AppArmorProfile=luma-hardware-daemon-observer
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service capget capset
SystemCallFilter=~@mount @raw-io @reboot @swap @obsolete @debug
SystemCallFilter=~ptrace process_vm_readv process_vm_writev bpf
LimitNOFILE=16
LimitCORE=0
LimitMEMLOCK=0
LimitCPU=1
MemoryMax=32M
MemorySwapMax=0
TasksMax=1
CPUQuota=100%
RuntimeMaxSec=2
TimeoutStartSec=2
TimeoutStopSec=1
KillMode=control-group
SendSIGKILL=yes
Restart=no
