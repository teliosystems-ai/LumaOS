[Unit]
Description=Luma local installation and recovery console
After=systemd-user-sessions.service media-luma.mount
ConditionKernelCommandLine=luma.mode=live

[Service]
Type=idle
ExecStart=/usr/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 ttyS0 linux
Restart=always
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
