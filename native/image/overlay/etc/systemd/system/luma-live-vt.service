[Unit]
Description=Luma local recovery display console
After=systemd-user-sessions.service media-luma.mount
ConditionKernelCommandLine=luma.mode=live

[Service]
Type=idle
ExecStart=/usr/sbin/agetty --autologin root --noclear tty1 linux
Restart=always
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
