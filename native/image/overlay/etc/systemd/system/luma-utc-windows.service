[Unit]
Description=Luma independent protected UTC publisher for Windows
After=apparmor.service local-fs.target luma-broker.service
Requires=apparmor.service luma-broker.service
ConditionPathExists=/var/lib/luma-os/utc-windows-checkpoint/sealed/anchor.json
ConditionPathExists=/var/lib/luma-os/utc-windows-checkpoint/genesis.json
ConditionPathExists=/var/lib/luma-os/utc-windows/journal.json
ConditionPathExists=/etc/luma-os/utc-windows/transport.json

[Service]
Type=simple
ExecStart=/usr/libexec/luma-os/luma-platform utc-windows-serve
User=root
Group=luma-utc-front
RuntimeDirectory=luma-utc-windows
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C OPENSSL_CONF=/dev/null
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT OPENSSL_MODULES SSLKEYLOGFILE PYTHONHOME PYTHONPATH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# One common ext4 bind preserves the checked child/parent mount identity.
# AppArmor admits only U's fixed read-only state, never another authority.
ReadWritePaths=/var/lib/luma-os
ReadWritePaths=/run/luma-utc-windows-checkpoint/authority.lock
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @memlock
SystemCallFilter=~@mount @raw-io @reboot @swap @obsolete @debug
CapabilityBoundingSet=
AmbientCapabilities=
AppArmorProfile=luma-utc-windows
MemoryMax=256M
MemorySwapMax=0
LimitMEMLOCK=100663296
LimitCORE=0
TasksMax=4
CPUQuota=100%
CPUQuotaPeriodSec=100ms
OOMPolicy=kill
TimeoutStopSec=5
Restart=on-failure
RestartSec=2
