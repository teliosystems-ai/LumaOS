#!/bin/bash
set -euo pipefail
if [ "$(/usr/bin/id -u)" != 0 ]; then
    echo 'Use sudo for the fixed recovery executor; original Admin custody is still required.' >&2
    exit 1
fi
case "${1:-}" in
    utc-seed|utc-reacquire|repair-a|repair-b) ;;
    *) echo 'Choose utc-seed, utc-reacquire, repair-a or repair-b; no general executor is provided.' >&2; exit 2 ;;
esac
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C LANG=C TZ=UTC \
    /usr/bin/aa-exec -p luma-recovery -- /usr/libexec/luma-os/luma-platform recover "$@"
