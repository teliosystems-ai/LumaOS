[Unit]
Description=Luma protected NTS quorum keeper and reviewed seed control
After=apparmor.service systemd-tmpfiles-setup.service local-fs.target
Requires=apparmor.service
Before=sleep.target
Conflicts=systemd-timesyncd.service chrony.service ntp.service sleep.target
ConditionKernelCommandLine=luma.mode=installed

[Service]
Type=simple
ExecStart=/usr/libexec/luma-os/luma-platform utc-keeper
User=root
Group=root
RuntimeDirectory=luma-utc-control luma-utc
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_SYS_PTRACE CAP_SYS_TIME
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=default
ProcSubset=all
ReadWritePaths=/run/luma-utc-control /run/luma-utc
InaccessiblePaths=/var/lib/luma-os /run/luma-admin /run/luma-governance /efi /boot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service clock_settime
SystemCallFilter=~@mount @raw-io @reboot @swap @obsolete
AppArmorProfile=luma-utc-keeper
LimitCORE=0
LimitNOFILE=128
LimitMEMLOCK=0
MemoryMax=128M
MemorySwapMax=0
TasksMax=4
CPUQuota=20%
TimeoutStopSec=5
KillMode=control-group
Restart=no

[Install]
WantedBy=multi-user.target
