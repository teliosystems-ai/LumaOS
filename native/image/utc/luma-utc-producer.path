[Unit]
Description=Start fixed NTS producer only after reviewed seed and protected bind
# Default Before=paths.target closes a cycle through the keeper's implicit
# After=basic.target; keep the other default edges explicitly.
DefaultDependencies=no
After=sysinit.target luma-utc-keeper.service
Requires=sysinit.target luma-utc-keeper.service
Conflicts=shutdown.target
Before=shutdown.target
BindsTo=luma-utc-keeper.service
ConditionKernelCommandLine=luma.mode=installed

[Path]
PathExists=/run/luma-utc/seed-ready
Unit=luma-utc-producer.service
TriggerLimitIntervalSec=60
TriggerLimitBurst=1

[Install]
WantedBy=multi-user.target
