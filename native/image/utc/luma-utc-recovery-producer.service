[Unit]
Description=Luma recovery-image fixed-provider authenticated NTS producer
After=apparmor.service network-online.target luma-utc-recovery-keeper.service
Requires=apparmor.service luma-utc-recovery-keeper.service
BindsTo=luma-utc-recovery-keeper.service
Wants=network-online.target
Conflicts=systemd-timesyncd.service chrony.service ntp.service luma-utc-keeper.service luma-utc-producer.service luma-utc-producer.path
ConditionKernelCommandLine=luma.mode=live
ConditionPathExists=/run/luma-utc/seed-ready
ConditionPathExists=/run/luma-utc/measurements.sock

[Service]
Type=simple
ExecStart=/usr/libexec/luma-os/chronyd -n -U -f /usr/share/luma-os/utc/chrony.conf -u luma-utc-producer -F 1
User=luma-utc-producer
Group=luma-utc-producer
RuntimeDirectory=luma-utc-producer
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077
Environment=LANG=C LC_ALL=C TZ=UTC PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME
AmbientCapabilities=CAP_SYS_TIME
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ReadWritePaths=/run/luma-utc-producer /run/luma-utc/measurements.sock
InaccessiblePaths=/var/lib/luma-os /run/luma-admin /run/luma-governance /run/luma-utc-control /efi /boot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @clock
SystemCallFilter=~@mount @raw-io @reboot @swap @obsolete @debug
AppArmorProfile=luma-utc-recovery-producer
LimitCORE=0
LimitNOFILE=128
MemoryMax=128M
MemorySwapMax=0
TasksMax=8
CPUQuota=20%
TimeoutStopSec=5
KillMode=control-group
Restart=no
