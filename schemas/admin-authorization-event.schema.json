{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-os.invalid/schemas/admin-authorization-event.schema.json",
  "title": "Luma OS Admin authorization log event",
  "description": "A schema-valid event is data only. Writer identity, HMAC/hash-chain verification, external-anchor currentness, and authorization acceptance are established by the durable Admin service, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "event_type",
    "occurred_at",
    "payload",
    "previous_event_sha256",
    "recorded_at",
    "schema_version",
    "sequence"
  ],
  "properties": {
    "artifact_type": {
      "const": "luma-os-admin-authorization-event"
    },
    "event_type": {
      "enum": [
        "assignment-grant",
        "assignment-revoke",
        "catalog-approval-authorization",
        "catalog-signing-authorization"
      ]
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "payload": {
      "type": "object"
    },
    "previous_event_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "$ref": "#/$defs/timestamp"
    },
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "$ref": "#/$defs/positiveInteger"
    }
  },
  "oneOf": [
    {
      "properties": {
        "event_type": {
          "const": "assignment-grant"
        },
        "payload": {
          "$ref": "#/$defs/assignmentGrant"
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "assignment-revoke"
        },
        "payload": {
          "$ref": "#/$defs/assignmentRevoke"
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "catalog-approval-authorization"
        },
        "payload": {
          "$ref": "#/$defs/catalogApprovalAuthorization"
        }
      }
    },
    {
      "properties": {
        "event_type": {
          "const": "catalog-signing-authorization"
        },
        "payload": {
          "$ref": "#/$defs/catalogSigningAuthorization"
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$",
      "not": {
        "pattern": "\\*"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activities",
        "activity_set_sha256",
        "assigned_by",
        "assignment_id",
        "expires_at",
        "issued_at",
        "revoked_at",
        "role",
        "role_version",
        "subject",
        "version"
      ],
      "properties": {
        "activities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "activity_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "assigned_by": {
          "$ref": "#/$defs/identifier"
        },
        "assignment_id": {
          "$ref": "#/$defs/identifier"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "revoked_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "role_version": {
          "$ref": "#/$defs/positiveInteger"
        },
        "subject": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "assignmentGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "assignment_receipt_sha256"
      ],
      "properties": {
        "assignment": {
          "$ref": "#/$defs/assignment"
        },
        "assignment_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "assignmentRevoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment",
        "revocation_receipt_sha256",
        "revoked_by"
      ],
      "properties": {
        "assignment": {
          "$ref": "#/$defs/assignment"
        },
        "revocation_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "revoked_by": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "catalogApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity",
        "approved_at",
        "approval_decision_receipt_sha256",
        "assignment_id",
        "assignment_receipt_sha256",
        "catalog_sha256",
        "decision",
        "principal_id",
        "release_request_sha256",
        "release_id"
      ],
      "properties": {
        "activity": {
          "$ref": "#/$defs/identifier"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "approval_decision_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "assignment_id": {
          "$ref": "#/$defs/identifier"
        },
        "assignment_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision": {
          "const": "approved"
        },
        "principal_id": {
          "$ref": "#/$defs/identifier"
        },
        "release_request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "catalogApprovalAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval"
      ],
      "properties": {
        "approval": {
          "$ref": "#/$defs/catalogApproval"
        }
      }
    },
    "catalogStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_set_sha256",
        "artifact_type",
        "catalog_id",
        "catalog_sequence",
        "catalog_sha256",
        "environment",
        "not_after",
        "not_before",
        "policy_version",
        "purpose",
        "release_id",
        "release_request_sha256",
        "schema_version",
        "signature_algorithm",
        "signed_at",
        "signer_key_id",
        "signing_activity",
        "signing_assignment_id",
        "signing_assignment_receipt_sha256",
        "signing_principal_id"
      ],
      "properties": {
        "approval_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_type": {
          "const": "model-profile-catalog"
        },
        "catalog_id": {
          "$ref": "#/$defs/identifier"
        },
        "catalog_sequence": {
          "$ref": "#/$defs/positiveInteger"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "environment": {
          "enum": [
            "lab",
            "production"
          ]
        },
        "not_after": {
          "$ref": "#/$defs/timestamp"
        },
        "not_before": {
          "$ref": "#/$defs/timestamp"
        },
        "policy_version": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "enum": [
            "model-profile-catalog-lab",
            "model-profile-catalog-production"
          ]
        },
        "release_id": {
          "$ref": "#/$defs/identifier"
        },
        "release_request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_version": {
          "const": 1
        },
        "signature_algorithm": {
          "const": "Ed25519"
        },
        "signed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "signer_key_id": {
          "$ref": "#/$defs/identifier"
        },
        "signing_activity": {
          "enum": [
            "model-catalog.sign.lab",
            "model-catalog.sign.production"
          ]
        },
        "signing_assignment_id": {
          "$ref": "#/$defs/identifier"
        },
        "signing_assignment_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signing_principal_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "catalogSigningAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/catalogStatement"
        }
      }
    }
  }
}
