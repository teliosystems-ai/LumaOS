{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-os.invalid/schemas/g3_quality.schema.json",
  "title": "Operator-pinned G3 quality evidence documents; cross-file joins enforced by g3_quality.py",
  "oneOf": [
    {"$ref": "#/$defs/corpus"}, {"$ref": "#/$defs/currentManifest"},
    {"$ref": "#/$defs/run"}, {"$ref": "#/$defs/adjudications"},
    {"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/measurement"}, {"$ref": "#/$defs/energy"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\u0000-\u001f\u007f]+$"},
    "integer": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "nullableInteger": {"oneOf": [{"$ref": "#/$defs/integer"}, {"type": "null"}]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}(/[A-Za-z0-9][A-Za-z0-9_.-]{0,95})*$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}, "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "namedPins": {
      "type": "array", "maxItems": 16,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "file"],
        "properties": {"name": {"$ref": "#/$defs/id"}, "file": {"$ref": "#/$defs/pin"}}}
    },
    "tuple": {
      "type": "object", "additionalProperties": false,
      "required": ["source_manifest_sha256", "image_manifest_sha256", "model_sha256", "runtime_sha256", "machine_id_sha256"],
      "properties": {
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"}, "image_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"}, "runtime_sha256": {"$ref": "#/$defs/sha256"},
        "machine_id_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "oracle": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {"kind": {"const": "must-refuse"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "rubric"],
          "properties": {"kind": {"const": "human-rubric"}, "rubric": {"$ref": "#/$defs/pin"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "artifact", "expected"],
          "properties": {"kind": {"enum": ["bytes-exact", "json-exact", "decimal-csv-exact"]},
            "artifact": {"$ref": "#/$defs/id"}, "expected": {"$ref": "#/$defs/pin"}}}
      ]
    },
    "task": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "expected", "inputs", "oracle"],
      "properties": {"task_id": {"$ref": "#/$defs/id"}, "expected": {"enum": ["complete", "refuse"]},
        "inputs": {"allOf": [{"$ref": "#/$defs/namedPins"}], "minItems": 1}, "oracle": {"$ref": "#/$defs/oracle"}}
    },
    "corpus": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "corpus_id", "classification", "tasks"],
      "properties": {"schema_version": {"const": 1}, "corpus_id": {"$ref": "#/$defs/id"},
        "classification": {"const": "external-held-out"}, "tasks": {"type": "array", "minItems": 500, "maxItems": 500, "items": {"$ref": "#/$defs/task"}}}
    },
    "currentManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "profile", "corpus_sha256", "tuple", "started_utc", "finished_utc"],
      "properties": {"schema_version": {"const": 1}, "run_id": {"$ref": "#/$defs/id"},
        "profile": {"enum": ["compact", "mainstream"]}, "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "tuple": {"$ref": "#/$defs/tuple"}, "started_utc": {"$ref": "#/$defs/timestamp"}, "finished_utc": {"$ref": "#/$defs/timestamp"}}
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "corpus_sha256", "current_manifest_sha256", "tuple"],
      "properties": {"run_id": {"$ref": "#/$defs/id"}, "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "current_manifest_sha256": {"$ref": "#/$defs/sha256"}, "tuple": {"$ref": "#/$defs/tuple"}}
    },
    "attempt": {
      "type": "object", "additionalProperties": false, "required": ["attempt", "status", "reason", "artifacts", "receipt", "measurement"],
      "properties": {"attempt": {"type": "integer", "minimum": 1, "maximum": 8},
        "status": {"enum": ["completed", "refused", "failed", "cancelled"]}, "reason": {"type": "string", "maxLength": 512},
        "artifacts": {"$ref": "#/$defs/namedPins"}, "receipt": {"$ref": "#/$defs/pin"}, "measurement": {"$ref": "#/$defs/pin"}}
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "context", "observations"],
      "properties": {"schema_version": {"const": 1}, "context": {"$ref": "#/$defs/context"},
        "observations": {"type": "array", "minItems": 500, "maxItems": 500,
          "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "input_set_sha256", "attempts"],
            "properties": {"task_id": {"$ref": "#/$defs/id"}, "input_set_sha256": {"$ref": "#/$defs/sha256"},
              "attempts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/attempt"}}}}}}
    },
    "adjudications": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "run_sha256", "context_sha256", "origin", "decisions"],
      "properties": {"schema_version": {"const": 1}, "run_sha256": {"$ref": "#/$defs/sha256"},
        "context_sha256": {"$ref": "#/$defs/sha256"}, "origin": {"const": "external-human"},
        "decisions": {"type": "array", "maxItems": 4000,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["task_id", "attempt", "artifact_set_sha256", "rubric_sha256", "reviewer", "decision", "reason"],
            "properties": {"task_id": {"$ref": "#/$defs/id"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 8},
              "artifact_set_sha256": {"$ref": "#/$defs/sha256"}, "rubric_sha256": {"$ref": "#/$defs/sha256"},
              "reviewer": {"$ref": "#/$defs/text"}, "decision": {"enum": ["pass", "fail"]}, "reason": {"$ref": "#/$defs/text"}}}}}
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "task_id", "attempt", "context_sha256", "input_set_sha256", "artifact_set_sha256", "status", "authority_returned"],
      "properties": {"schema_version": {"const": 1}, "run_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 8}, "context_sha256": {"$ref": "#/$defs/sha256"},
        "input_set_sha256": {"$ref": "#/$defs/sha256"}, "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["completed", "refused", "failed", "cancelled"]}, "authority_returned": {"const": false}}
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "task_id", "attempt", "context_sha256", "clock", "started_ns", "finished_ns", "ack_ns", "first_result_ns", "cancel_requested_ns", "cancel_ack_ns", "peak_memory_bytes", "peak_memory_evidence", "energy_evidence"],
      "properties": {"schema_version": {"const": 1}, "run_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 8}, "context_sha256": {"$ref": "#/$defs/sha256"},
        "clock": {"const": "run-relative-monotonic-ns"}, "started_ns": {"$ref": "#/$defs/integer"},
        "finished_ns": {"$ref": "#/$defs/integer"}, "ack_ns": {"$ref": "#/$defs/integer"},
        "first_result_ns": {"$ref": "#/$defs/nullableInteger"}, "cancel_requested_ns": {"$ref": "#/$defs/nullableInteger"},
        "cancel_ack_ns": {"$ref": "#/$defs/nullableInteger"}, "peak_memory_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "peak_memory_evidence": {"$ref": "#/$defs/pin"}, "energy_evidence": {"$ref": "#/$defs/pin"}}
    },
    "energy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "task_id", "attempt", "context_sha256", "method", "domain", "started_ns", "finished_ns", "start_microjoules", "end_microjoules"],
      "properties": {"schema_version": {"const": 1}, "run_id": {"$ref": "#/$defs/id"}, "task_id": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 8}, "context_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"enum": ["kernel-counter", "external-meter"]}, "domain": {"$ref": "#/$defs/text"},
        "started_ns": {"$ref": "#/$defs/integer"}, "finished_ns": {"$ref": "#/$defs/integer"},
        "start_microjoules": {"$ref": "#/$defs/integer"}, "end_microjoules": {"$ref": "#/$defs/integer"}}
    }
  }
}
