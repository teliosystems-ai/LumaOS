{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-os.invalid/schemas/model-pack.schema.json",
  "title": "Luma OS immutable model-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "signature_algorithm",
    "pack_id",
    "pack_version",
    "model",
    "context",
    "blobs",
    "runtime_tuples",
    "installation_profiles",
    "license",
    "network_default",
    "signer_key_id"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "canonicalization": { "const": "RFC8785-ASCII-v1" },
    "signature_algorithm": { "const": "Ed25519" },
    "pack_id": { "$ref": "#/$defs/asciiText" },
    "pack_version": { "$ref": "#/$defs/asciiText" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "identity",
        "parameter_class",
        "total_parameters",
        "active_parameters_min",
        "active_parameters_max",
        "quantization",
        "required_features",
        "source"
      ],
      "properties": {
        "architecture": { "$ref": "#/$defs/asciiText" },
        "identity": { "$ref": "#/$defs/asciiText" },
        "parameter_class": { "$ref": "#/$defs/asciiText" },
        "total_parameters": { "$ref": "#/$defs/positiveSafeInteger" },
        "active_parameters_min": { "$ref": "#/$defs/positiveSafeInteger" },
        "active_parameters_max": { "$ref": "#/$defs/positiveSafeInteger" },
        "quantization": { "$ref": "#/$defs/asciiText" },
        "required_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/asciiText" }
        },
        "source": { "$ref": "#/$defs/asciiTextLong" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_tokens", "template_sha256"],
      "properties": {
        "maximum_tokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "template_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "blobs": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/blobDeclaration" }
    },
    "runtime_tuples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/runtimeTuple" }
    },
    "installation_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/installationProfile" }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "evaluation", "redistribution", "files"],
      "properties": {
        "identifier": { "$ref": "#/$defs/asciiText" },
        "evaluation": { "enum": ["approved", "denied", "pending"] },
        "redistribution": { "enum": ["approved", "denied", "not-applicable", "pending"] },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/asciiTextLong" }
        }
      }
    },
    "network_default": { "const": "deny" },
    "signer_key_id": { "$ref": "#/$defs/asciiText" }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[ -~]+$"
    },
    "asciiTextLong": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[ -~]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blobDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "path", "sha256", "size_bytes", "shard_index"],
          "properties": {
            "role": { "const": "model" },
            "path": { "$ref": "#/$defs/contentBlobPath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
            "shard_index": { "$ref": "#/$defs/nonNegativeSafeInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "path", "sha256", "size_bytes"],
          "properties": {
            "role": { "enum": ["tokenizer", "template", "auxiliary"] },
            "path": { "$ref": "#/$defs/contentBlobPath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size_bytes": { "$ref": "#/$defs/positiveSafeInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "path", "sha256", "size_bytes"],
          "properties": {
            "role": { "const": "license" },
            "path": { "$ref": "#/$defs/licensePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size_bytes": { "$ref": "#/$defs/positiveSafeInteger" }
          }
        }
      ]
    },
    "runtimeTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_family", "architecture", "backend", "backend_version", "device"],
      "properties": {
        "os_family": { "$ref": "#/$defs/asciiText" },
        "architecture": { "$ref": "#/$defs/asciiText" },
        "backend": { "$ref": "#/$defs/asciiText" },
        "backend_version": { "$ref": "#/$defs/asciiText" },
        "device": { "$ref": "#/$defs/asciiText" }
      }
    },
    "installationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "runtime_tuple_sha256",
        "execution_mode",
        "minimum_host_ram_bytes",
        "minimum_accelerator_memory_bytes",
        "minimum_model_storage_bytes",
        "maximum_context_tokens"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/asciiText" },
        "runtime_tuple_sha256": { "$ref": "#/$defs/sha256" },
        "execution_mode": { "enum": ["cpu", "cuda"] },
        "minimum_host_ram_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "minimum_accelerator_memory_bytes": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "minimum_model_storage_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "maximum_context_tokens": { "$ref": "#/$defs/positiveSafeInteger" }
      }
    },
    "contentBlobPath": {
      "type": "string",
      "pattern": "^blobs/sha256/[0-9a-f]{64}$"
    },
    "licensePath": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024,
      "pattern": "^licenses/[ -~]+$"
    }
  }
}
