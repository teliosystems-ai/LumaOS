{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-os.invalid/schemas/signing-trust-bundle.schema.json",
  "title": "Luma OS root-signed public signing trust bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle",
    "schema_version",
    "signature",
    "signature_algorithm",
    "signature_encoding"
  ],
  "properties": {
    "bundle": { "$ref": "#/$defs/bundle" },
    "schema_version": { "const": 1 },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "signature_algorithm": { "const": "Ed25519" },
    "signature_encoding": { "const": "base64" }
  },
  "$defs": {
    "asciiText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[ -~]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "purpose": {
      "enum": [
        "model-pack-manifest",
        "model-pack-execution-certification",
        "model-pack-interactive-certification",
        "model-profile-catalog-lab",
        "model-profile-catalog-production"
      ]
    },
    "role": {
      "enum": [
        "model-pack-signer",
        "model-pack-certification-signer",
        "model-profile-catalog-lab-signer",
        "model-profile-catalog-production-signer"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "key_id",
        "not_after",
        "not_before",
        "public_key",
        "public_key_encoding",
        "purposes",
        "revocation_reason",
        "revoked_at",
        "role"
      ],
      "properties": {
        "environment": { "enum": ["lab", "production"] },
        "key_id": { "$ref": "#/$defs/asciiText" },
        "not_after": { "$ref": "#/$defs/utcTimestamp" },
        "not_before": { "$ref": "#/$defs/utcTimestamp" },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "public_key_encoding": { "const": "raw-ed25519-base64" },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/purpose" }
        },
        "revocation_reason": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/asciiText" }
          ]
        },
        "revoked_at": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/utcTimestamp" }
          ]
        },
        "role": { "$ref": "#/$defs/role" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "environment": { "const": "lab" }
            },
            "required": ["environment"]
          },
          "then": {
            "properties": {
              "purposes": {
                "not": {
                  "contains": {
                    "const": "model-profile-catalog-production"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "environment": { "const": "production" }
            },
            "required": ["environment"]
          },
          "then": {
            "properties": {
              "purposes": {
                "not": {
                  "contains": { "const": "model-profile-catalog-lab" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "revoked_at": { "type": "null" }
            },
            "required": ["revoked_at"]
          },
          "then": {
            "properties": {
              "revocation_reason": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "revocation_reason": { "$ref": "#/$defs/asciiText" }
            }
          }
        }
      ]
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "bundle_sequence",
        "environment",
        "issued_at",
        "keys",
        "not_after",
        "not_before",
        "policy_version",
        "previous_bundle_sha256",
        "root_key_id",
        "schema_version",
        "trust_domain"
      ],
      "properties": {
        "artifact_type": { "const": "luma-os-signing-trust-bundle" },
        "bundle_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "environment": { "enum": ["lab", "production"] },
        "issued_at": { "$ref": "#/$defs/utcTimestamp" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/key" }
        },
        "not_after": { "$ref": "#/$defs/utcTimestamp" },
        "not_before": { "$ref": "#/$defs/utcTimestamp" },
        "policy_version": { "$ref": "#/$defs/asciiText" },
        "previous_bundle_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "root_key_id": { "$ref": "#/$defs/asciiText" },
        "schema_version": { "const": 1 },
        "trust_domain": { "$ref": "#/$defs/asciiText" }
      }
    }
  }
}
